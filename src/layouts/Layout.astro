---
import "@fontsource/space-mono";
import "@/styles/global.css";
import HeaderLink from "@/components/HeaderLink.astro";
import Footer from "@/components/Footer.astro";
import SelectDivision from "@/components/SelectDivision.astro";

import { ClientRouter } from "astro:transitions";

interface Props {
  tournamentId?: string;
  title?: string;
  description?: string;
}

const { tournamentId, title = "Are We Playing?", description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="vhnEvLSZ4cAdbDdRlkwQdS8jq2PFCV1C3j1HWywmR6o"
    />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="font-sans antialiased">
    <div class="min-h-screen bg-background">
      <header
        class="border-b-4 border-foreground bg-background sticky top-0 z-10"
      >
        <div class="container mx-auto px-4">
          <div class="flex items-center justify-between py-6">
            <nav class="flex items-center gap-6 md:gap-8">
              <HeaderLink href="/" aria-label="Ver torneos">
                Torneos
              </HeaderLink>

              {
                tournamentId ? (
                  <HeaderLink
                    href={`/${tournamentId}/teams`}
                    aria-label="Ver equipos"
                  >
                    Equipos
                  </HeaderLink>
                ) : null
              }
            </nav>

            <div class="flex items-center gap-4">
              <div class="hidden md:inline-block">
                {
                  tournamentId ? (
                    <SelectDivision
                      id="division-desktop"
                      defaultSelected={tournamentId}
                    />
                  ) : null
                }
              </div>
            </div>
          </div>
        </div>
      </header>
      <div
        class="container mx-auto px-4 py-8 md:py-12 flex flex-col gap-8 md:gap-12"
      >
        <slot />
      </div>
    </div>
    <Footer />
  </body>
</html>
