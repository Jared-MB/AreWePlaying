---
import "@fontsource/space-mono";
import "@/styles/global.css";
// sonner inyecta su CSS en <head> al evaluarse el módulo; el swap del ClientRouter
// lo elimina al navegar y nunca se vuelve a inyectar. Importarlo aquí lo deja en el
// bundle de estilos de la página, donde el swap sí lo preserva.
import "sonner/dist/styles.css";
import HeaderLink from "@/components/HeaderLink.astro";
import Footer from "@/components/Footer.astro";
import SelectDivision from "@/components/SelectDivision.astro";
import { Toaster } from "@/components/sonner";

import { ClientRouter } from "astro:transitions";

interface Props {
  tournamentId?: string;
  title?: string;
  description?: string;
  /** Imagen de la tarjeta social. Ruta relativa al sitio o URL absoluta. */
  image?: string;
  icon?: {
    href?: string;
    type?: string;
  };
}

const SITE_NAME = "Are We Playing?";
const DEFAULT_DESCRIPTION =
  "Calendario de partidos de basketball de la liga ABE: jornadas, resultados y próximos juegos de cada equipo.";

const {
  tournamentId,
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  image = "/og.png",
  icon,
} = Astro.props;

// og:* y twitter:* exigen URLs absolutas; los scrapers no resuelven rutas relativas.
// Astro.site viene de `site` en astro.config.ts.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(icon?.href ?? image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="vhnEvLSZ4cAdbDdRlkwQdS8jq2PFCV1C3j1HWywmR6o"
    />
    <meta name="description" content={description} />
    <link
      rel="icon"
      type={icon?.type ?? "image/svg+xml"}
      href={icon?.href ?? "/favicon.svg"}
    />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    {
      socialImageUrl.pathname.endsWith(".png") ? (
        <>
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      ) : (
        <meta property="og:image:type" content="image/svg+xml" />
      )
    }
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <ClientRouter />
  </head>
  <body class="font-sans antialiased">
    <div class="min-h-screen bg-background">
      <header
        class="border-b-4 border-foreground bg-background sticky top-0 z-10"
      >
        <div class="container mx-auto px-4">
          <div class="flex items-center justify-between py-6">
            <nav class="flex items-center gap-6 md:gap-8">
              <HeaderLink href="/" aria-label="Ver torneos">
                Torneos
              </HeaderLink>

              {
                tournamentId ? (
                  <HeaderLink
                    href={`/${tournamentId}/teams`}
                    aria-label="Ver equipos"
                  >
                    Equipos
                  </HeaderLink>
                ) : null
              }
            </nav>

            <div class="flex items-center gap-4">
              <div class="hidden md:inline-block">
                {
                  tournamentId ? (
                    <SelectDivision
                      id="division-desktop"
                      defaultSelected={tournamentId}
                    />
                  ) : null
                }
              </div>
            </div>
          </div>
        </div>
      </header>
      <div
        class="container mx-auto px-6 md:px-4 py-8 md:py-12 flex flex-col gap-8 md:gap-12"
      >
        <slot />
      </div>
    </div>
    <Footer />
    <Toaster client:load />
  </body>
</html>
