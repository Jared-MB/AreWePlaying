---
import BranchFilter from "@/components/BranchFilter.astro";
import WeekPicker from "@/components/WeekPicker.astro";
import Layout from "@/layouts/Layout.astro";
import { getTournaments } from "@/utils/get-tournaments";
import { getTournamentSlug } from "@/utils/tournament-slug";
import { getWeeks } from "@/utils/get-weeks";
import { getCurrentWeek } from "@/utils/get-current-week";
import type { Tournament } from "@/types/tournament";
import AreWePlaying from "@/components/AreWePlaying.astro";
import SelectDivision from "@/components/SelectDivision.astro";
import type { Props as HeadProps } from "./HeadlessLayout.astro";

interface Props extends HeadProps {
  tournament: Tournament;
  /** Slug de la jornada activa, p. ej. "semana-1". */
  weekSlug?: string;
}

const { tournament, weekSlug, ...headProps } = Astro.props;

// Las URLs usan el slug; los archivos de datos siguen indexados por UUID.
const tournamentSlug = getTournamentSlug(tournament);
const tournamentId = tournament.id.toLowerCase();

const tournaments = getTournaments();

const tournamentsByConference = tournaments.filter((t) =>
  tournament.conference
    ? t.conference === tournament.conference &&
      t.division === tournament.division
    : t.division === tournament.division,
);

const womenTournament = tournamentsByConference.find(
  (t) => t.category === "Femenil",
);
const menTournament = tournamentsByConference.find(
  (t) => t.category === "Varonil",
);

const weeks = await getWeeks(tournamentId);
---

<Layout tournamentSlug={tournamentSlug} {...headProps}>
  <AreWePlaying />
  <div>
    <div class="space-y-6 mb-6">
      <div class="flex md:hidden flex-wrap items-center gap-3">
        <label
          for="division-mobile"
          class="text-xs font-bold uppercase tracking-widest text-muted-foreground"
        >
          Division:
        </label>
        <SelectDivision id="division-mobile" defaultSelected={tournamentSlug} />
      </div>
      <hr />
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
        <BranchFilter
          current={tournament}
          women={womenTournament}
          men={menTournament}
        />
        <WeekPicker
          tournamentSlug={tournamentSlug}
          weeks={weeks}
          weekSlug={weekSlug}
          currentWeekId={getCurrentWeek(weeks)?.id}
        />
      </div>
    </div>
    <slot />
  </div>
</Layout>
