---
import "@fontsource/space-mono";
import "@fontsource-variable/geist-pixel";
import "@/styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

import {
  DEFAULT_DESCRIPTION,
  DEFAULT_IMAGE_ALT,
  SITE_NAME,
  serializeJsonLd,
} from "@/utils/seo";

export interface Props {
  title?: string;
  description?: string;
  /** Imagen de la tarjeta social (PNG de 1200×630). Ruta relativa al sitio o URL absoluta. */
  image?: string;
  /** Texto alternativo de `image`; describe lo que se ve, no repite el título. */
  imageAlt?: string;
  icon?: {
    href?: string;
    type?: string;
  };
  /** Páginas que no deben aparecer en buscadores (p. ej. el 404). */
  noindex?: boolean;
  /** Datos estructurados de schema.org para la página. */
  jsonLd?: object;
}

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  image = "/og.png",
  imageAlt = image === "/og.png" ? DEFAULT_IMAGE_ALT : title,
  icon,
  noindex = false,
  jsonLd,
} = Astro.props;

// og:* y twitter:* exigen URLs absolutas; los scrapers no resuelven rutas relativas.
// Astro.site viene de `site` en astro.config.ts. La canónica va sin "/" final,
// igual que los enlaces internos y el sitemap (`trailingSlash: "never"`).
const canonicalPath = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
// El escudo del equipo sirve de favicon, pero no de tarjeta social: es AVIF y
// cuadrado, y ni WhatsApp ni X lo muestran.
const socialImageUrl = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="vhnEvLSZ4cAdbDdRlkwQdS8jq2PFCV1C3j1HWywmR6o"
    />
    <meta name="description" content={description} />
    {
      // Una página fuera del índice no necesita canónica (y la del 404 apuntaría
      // a una URL que no existe).
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonicalUrl} />
      )
    }
    <link
      rel="icon"
      type={icon?.type ?? "image/svg+xml"}
      href={icon?.href ?? "/favicon.svg"}
    />
    {
      // Respaldo raster para navegadores sin favicon SVG y para Google, que pide
      // múltiplos de 48 px. Las páginas con icono propio (escudo) no lo llevan.
      icon ? null : (
        <link
          rel="icon"
          type="image/png"
          sizes="48x48"
          href="/favicon-48.png"
        />
      )
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {
      jsonLd ? (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd(jsonLd)}
        />
      ) : null
    }
    <ClientRouter />
    <script is:inline>
      // Aplica el tema antes del primer pintado para evitar el parpadeo. La clave
      // debe coincidir con LOCAL_STORAGE_THEME_KEY (los scripts inline no importan).
      (() => {
        const applyTheme = () => {
          let theme = null;
          try {
            theme = localStorage.getItem("theme");
          } catch {}
          const isDark = theme
            ? theme === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", isDark);
          document.documentElement.style.colorScheme = isDark
            ? "dark"
            : "light";
        };
        applyTheme();
        // El ClientRouter reemplaza los atributos de <html> al navegar.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:shadow-xs"
    >
      Saltar al contenido
    </a>
    <slot />
    <Analytics />
  </body>
</html>
