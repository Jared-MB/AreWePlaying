---
import Search from "@lucide/astro/icons/search";

import Layout from "@/layouts/Layout.astro";
import { getTeamsByTournament } from "@/utils/get-teams-by-tournament";
import { normalizeSearch } from "@/utils/normalize-search";

// Directorio de todos los equipos de la temporada, una sección por torneo, al
// estilo de la página de equipos de la NBA.
const groups = await getTeamsByTournament();

const title = "Equipos | Are We Playing?";
const description =
  "Todos los equipos de la liga ABE en esta temporada, agrupados por división y rama.";
---

<Layout title={title} description={description}>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-10">
    <h1
      class="border-b border-line/70 pb-4 font-mono text-4xl font-bold uppercase tracking-tight md:text-6xl"
    >
      Todos los equipos
    </h1>

    <search class="md:hidden">
      <form action="/teams" class="flex items-center gap-3">
        <label for="teams-search" class="sr-only">Buscar equipo</label>
        <div
          class="relative flex h-12 w-full max-w-md items-center gap-3 px-5 before:pointer-events-none before:absolute before:top-0 before:left-0 before:size-3 before:border-t-2 before:border-l-2 before:border-foreground before:transition-colors after:pointer-events-none after:absolute after:right-0 after:bottom-0 after:size-3 after:border-r-2 after:border-b-2 after:border-foreground after:transition-colors focus-within:before:border-primary focus-within:after:border-primary motion-reduce:before:transition-none motion-reduce:after:transition-none"
        >
          <Search aria-hidden="true" class="size-5 shrink-0 text-primary" />
          <input
            id="teams-search"
            data-teams-search
            type="text"
            name="equipo"
            enterkeyhint="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Buscar equipo…"
            aria-describedby="teams-search-status"
            class="min-w-0 flex-1 bg-transparent text-base font-bold uppercase tracking-wider outline-none placeholder:font-normal placeholder:normal-case placeholder:text-muted-foreground"
          />
        </div>
      </form>
      <p
        id="teams-search-status"
        data-teams-status
        aria-live="polite"
        class="sr-only"
      >
      </p>
    </search>

    <p data-teams-empty hidden class="text-base">
      Ningún equipo coincide con “<span data-teams-query></span>”.
    </p>

    <div data-teams-list class="grid gap-x-10 gap-y-12">
      {
        groups.map((group) => (
          <section
            data-teams-group
            aria-labelledby={`teams-${group.slug}`}
            class="min-w-0"
          >
            <div class="mb-4 flex items-baseline justify-between gap-4">
              <h2
                id={`teams-${group.slug}`}
                class="min-w-0 scroll-mt-28 font-mono text-sm font-bold uppercase tracking-wider"
              >
                {group.label}
              </h2>
              <a
                href={`/${group.slug}/teams`}
                class="shrink-0 text-xs font-bold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:underline"
              >
                Tabla
              </a>
            </div>

            {group.teams.length === 0 ? (
              <p class="text-sm text-muted-foreground">
                Aún no hay equipos registrados en este torneo.
              </p>
            ) : (
              <ul class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                {group.teams.map((team) => (
                  <li
                    data-search={normalizeSearch(`${team.name} ${group.label}`)}
                    class="group relative flex items-start gap-4 rounded-md px-3 py-2 transition-colors hover:bg-surface-hover has-[[data-team-link]:focus-visible]:outline-2 has-[[data-team-link]:focus-visible]:outline-ring"
                  >
                    {team.logo ? (
                      <img
                        src={team.logo}
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                        class="size-10 shrink-0 object-contain"
                      />
                    ) : (
                      <span
                        aria-hidden="true"
                        class="grid size-10 shrink-0 place-items-center rounded-sm bg-inverse text-xs font-bold uppercase text-inverse-foreground"
                      >
                        {team.initials}
                      </span>
                    )}
                    <div class="min-w-0">
                      {/* Enlace extendido: su ::after cubre todo el <li>; los enlaces de abajo van encima. */}
                      <a
                        href={team.href}
                        data-team-link
                        class="block wrap-break-word text-base font-bold leading-snug outline-none after:absolute after:inset-0 after:content-[''] group-hover:underline"
                      >
                        {team.name}
                      </a>
                      <ul
                        aria-label={`Secciones de ${team.name}`}
                        class="mt-1 flex flex-wrap gap-x-4 text-sm text-muted-foreground"
                      >
                        <li>
                          <a
                            href={`${team.href}#team-stats`}
                            class="relative z-10 hover:text-foreground hover:underline"
                          >
                            Estadísticas
                          </a>
                        </li>
                        <li>
                          <a
                            href={`${team.href}#team-matches`}
                            class="relative z-10 hover:text-foreground hover:underline"
                          >
                            Partidos
                          </a>
                        </li>
                      </ul>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  import { normalizeSearch } from "@/utils/normalize-search";

  const PARAM = "equipo";

  const filterTeams = (query: string) => {
    const $list = document.querySelector<HTMLElement>("[data-teams-list]");
    if (!$list) return;

    const tokens = normalizeSearch(query).split(" ").filter(Boolean);
    let matches = 0;

    for (const $item of $list.querySelectorAll<HTMLElement>("li[data-search]")) {
      const haystack = $item.dataset.search ?? "";
      const isMatch = tokens.every((token) => haystack.includes(token));
      $item.hidden = !isMatch;
      if (isMatch) matches++;
    }

    for (const $group of $list.querySelectorAll<HTMLElement>(
      "[data-teams-group]",
    )) {
      $group.hidden = !$group.querySelector("li[data-search]:not([hidden])");
    }

    const $empty = document.querySelector<HTMLElement>("[data-teams-empty]");
    if ($empty) {
      $empty.hidden = matches > 0;
      const $query = $empty.querySelector("[data-teams-query]");
      if ($query) $query.textContent = query.trim();
    }

    const $status = document.querySelector("[data-teams-status]");
    if ($status) {
      $status.textContent =
        matches === 0
          ? "Sin resultados"
          : `${matches} ${matches === 1 ? "equipo" : "equipos"}`;
    }
  };

  // La búsqueda vive en la URL (?equipo=…): se puede compartir y es lo que envía
  // el formulario cuando no hay JavaScript.
  const syncUrl = (query: string) => {
    const url = new URL(window.location.href);
    if (query.trim()) url.searchParams.set(PARAM, query.trim());
    else url.searchParams.delete(PARAM);
    window.history.replaceState(window.history.state, "", url);
  };

  // El ClientRouter no vuelve a ejecutar el módulo al navegar; este evento sí
  // se dispara en cada página.
  document.addEventListener("astro:page-load", () => {
    const $input = document.querySelector<HTMLInputElement>(
      "[data-teams-search]",
    );
    // En escritorio el campo está oculto (ahí se busca desde el menú "Equipos"):
    // no se filtra la lista sin que se vea por qué.
    if (!$input?.checkVisibility()) return;

    const query = new URLSearchParams(window.location.search).get(PARAM) ?? "";
    $input.value = query;
    if (query) filterTeams(query);
  });

  document.addEventListener("input", (e) => {
    const $input = (e.target as HTMLElement | null)?.closest<HTMLInputElement>(
      "[data-teams-search]",
    );
    if (!$input) return;

    filterTeams($input.value);
    syncUrl($input.value);
  });

  // Con JavaScript el filtro ya se aplicó al teclear; evita recargar la página.
  document.addEventListener("submit", (e) => {
    if ((e.target as HTMLElement | null)?.querySelector("[data-teams-search]")) {
      e.preventDefault();
    }
  });
</script>
