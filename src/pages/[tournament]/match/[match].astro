---
import MatchStory from "@/components/match-story.tsx";
import { SITE_HOST } from "@/constants/site";
import Layout from "@/layouts/Layout.astro";
import type { Match } from "@/types/match";
import type { TeamPosition } from "@/types/team";
import type { Week } from "@/types/week";
import { getMatchesWithWeek } from "@/utils/get-match";
import { MATCH_STATUS_LABEL, getMatchStatus } from "@/utils/get-match-status";
import {
  buildMatchCard,
  getTournamentLabel,
  teamInitials,
} from "@/utils/get-match-card";
import { getTeamsTable } from "@/utils/get-teams-table";
import { getTournaments } from "@/utils/get-tournaments";
import {
  getTournamentSlug,
  requireTournamentBySlug,
} from "@/utils/tournament-slug";
import { getMatchSlug } from "@/utils/match-slug";
import { getTeamSlug } from "@/utils/team-slug";
import { getWeekSlug } from "@/utils/week-slug";
import { slugify } from "@/utils/slugify";
import { format, isValid, parse } from "date-fns";
import { es } from "date-fns/locale";

export async function getStaticPaths() {
  const perTournament = getTournaments().map(async (t) => {
    const tournamentId = t.id.toLowerCase();

    const [matches, teams] = await Promise.all([
      getMatchesWithWeek(tournamentId),
      getTeamsTable(tournamentId),
    ]);

    return matches.map(({ match, week }) => ({
      params: {
        tournament: getTournamentSlug(t),
        match: getMatchSlug(match),
      },
      props: {
        match,
        week,
        localStats: teams.find((t) => t.id === match.localTeamId),
        visitingStats: teams.find((t) => t.id === match.visitingTeamId),
        // Enfrentamientos previos de estos dos equipos dentro del mismo torneo.
        headToHead: matches
          .map(({ match: other }) => other)
          .filter(
            (other) =>
              other.matchId !== match.matchId &&
              [other.localTeamId, other.visitingTeamId].every((teamId) =>
                [match.localTeamId, match.visitingTeamId].includes(teamId),
              ),
          ),
      },
    }));
  });

  return (await Promise.all(perTournament)).flat();
}

interface Props {
  match: Match;
  week?: Week;
  localStats?: TeamPosition;
  visitingStats?: TeamPosition;
  headToHead: Match[];
}

const tournament = requireTournamentBySlug(Astro.params.tournament);
const tournamentSlug = Astro.params.tournament;

const { match, week, localStats, visitingStats, headToHead } = Astro.props;

const card = buildMatchCard({
  tournament,
  match,
  week,
  localStats,
  visitingStats,
});

const { status } = card;
const hasScore = status !== "upcoming";

const [rawDate, rawTime = ""] = match.date.split(" ");
const parsedDate = parse(rawDate, "dd/MM/yyyy", new Date());
const longDate = isValid(parsedDate)
  ? format(parsedDate, "EEEE d 'de' MMMM 'de' yyyy", { locale: es })
  : rawDate;

const teams = [
  { side: card.local, role: "Local" as const, stats: localStats },
  { side: card.visiting, role: "Visitante" as const, stats: visitingStats },
].map(({ side, role, stats }) => ({
  ...side,
  role,
  stats,
  fullName: stats?.name ?? side.name,
  slug: getTeamSlug({ shortName: side.name }),
}));

const comparison = [
  { label: "Posición", get: (t: TeamPosition) => `#${t.position}` },
  { label: "Récord", get: (t: TeamPosition) => `${t.wins}W - ${t.losses}L` },
  { label: "Win rate", get: (t: TeamPosition) => `${t.percentage}%` },
  { label: "Puntos a favor", get: (t: TeamPosition) => String(t.goalsFor) },
  {
    label: "Puntos en contra",
    get: (t: TeamPosition) => String(t.goalsAgainst),
  },
  {
    label: "Diferencia",
    get: (t: TeamPosition) =>
      `${t.goalDifference > 0 ? "+" : ""}${t.goalDifference}`,
  },
];

const tournamentLabel = getTournamentLabel(tournament);
const hasVenueLink = match.locationUrl && match.locationUrl !== "-";
const venue = card.venue;

const title = `${match.localTeam} vs ${match.visitingTeam}${hasScore ? ` ${match.localTeamPoints}-${match.visitingTeamPoints}` : ""} | Are We Playing?`;
const description = `${match.localTeam} vs ${match.visitingTeam} · ${longDate}${rawTime ? ` a las ${rawTime}` : ""} · ${venue}. ${tournamentLabel}.`;
---

<Layout
  tournamentSlug={tournamentSlug}
  title={title}
  description={description}
>
  <div class="mx-auto w-full max-w-5xl">
    <div class="mb-6 flex items-center justify-between gap-4">
      <a
        href={
          week
            ? `/${tournamentSlug}/${getWeekSlug(week)}`
            : `/${tournamentSlug}`
        }
        class="rounded-md bg-surface px-4 py-2 text-sm font-bold uppercase tracking-wider shadow-xs transition-transform duration-180 hover:bg-surface-hover/70 focus-visible:scale-95"
      >
        ← Regresar
      </a>

      <span
        class={`rounded-md border border-line/70 px-3 py-1 text-xs font-bold uppercase tracking-wider ${
          status === "finished"
            ? "bg-muted text-muted-foreground"
            : "bg-primary text-primary-foreground"
        }`}
      >
        {MATCH_STATUS_LABEL[status]}
      </span>
    </div>

    <header class="mb-8 border-b border-b-line/70 pb-6">
      <p
        class="mb-2 text-xs font-bold uppercase tracking-widest text-muted-foreground"
      >
        {tournamentLabel}{week ? ` · ${week.week}` : ""} · Partido {
          match.matchNumber
        }
      </p>
      <h1
        class="font-mono text-3xl font-bold uppercase tracking-wider text-balance md:text-5xl flex flex-wrap items-baseline gap-4"
      >
        {match.localTeam}
        <span class="text-muted-foreground text-3xl">vs</span>
        {match.visitingTeam}
      </h1>
      <p class="mt-3 text-sm uppercase tracking-wider text-muted-foreground">
        {longDate}{rawTime ? ` · ${rawTime} hrs` : ""}
      </p>
    </header>

    <section
      aria-label="Marcador"
      class="mb-8 rounded-md bg-surface p-6 shadow-xs md:p-8"
    >
      <div class="flex flex-col gap-6">
        {
          teams.map((team) => (
            <div class="flex items-center gap-4">
              <div class="flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-full border border-line/70 bg-primary md:size-20">
                {team.logo ? (
                  <img
                    src={team.logo}
                    alt=""
                    width="80"
                    height="80"
                    class="size-full bg-white object-contain p-1.5"
                    loading="eager"
                  />
                ) : (
                  <span class="text-sm font-bold text-primary-foreground md:text-base">
                    {teamInitials(team.name)}
                  </span>
                )}
              </div>

              <div class="min-w-0 flex-1">
                <a
                  href={`/${tournamentSlug}/teams/${team.slug}`}
                  class="font-mono text-xl font-bold uppercase tracking-wide wrap-break-word hover:underline md:text-3xl"
                >
                  {team.name}
                </a>
                <p class="mt-1 text-xs font-bold uppercase tracking-wider text-muted-foreground">
                  {[team.role, team.position, team.record]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              </div>

              {hasScore ? (
                <p
                  class={`shrink-0 rounded-md border border-line/70 px-4 py-1 font-mono text-3xl font-bold tabular-nums md:text-5xl ${
                    team.isWinner
                      ? "bg-primary text-primary-foreground"
                      : "bg-muted text-muted-foreground"
                  }`}
                >
                  {team.points}
                </p>
              ) : null}
            </div>
          ))
        }
      </div>
    </section>

    <section
      aria-label="Detalles del partido"
      class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
    >
      <article class="rounded-md bg-surface p-4 shadow-xs">
        <p
          class="text-xs font-bold uppercase tracking-widest text-muted-foreground"
        >
          Fecha
        </p>
        <p class="mt-1 font-mono text-lg font-bold uppercase">{card.dateLabel}</p>
      </article>
      <article class="rounded-md bg-surface p-4 shadow-xs">
        <p
          class="text-xs font-bold uppercase tracking-widest text-muted-foreground"
        >
          Hora
        </p>
        <p class="mt-1 font-mono text-lg font-bold tabular-nums">
          {rawTime ? `${rawTime} HRS` : "—"}
        </p>
      </article>
      <article class="rounded-md bg-surface p-4 shadow-xs sm:col-span-2">
        <p
          class="text-xs font-bold uppercase tracking-widest text-muted-foreground"
        >
          Sede
        </p>
        {
          hasVenueLink ? (
            <a
              href={match.locationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 block font-mono text-lg font-bold uppercase wrap-break-word hover:underline"
            >
              {venue}
            </a>
          ) : (
            <p class="mt-1 font-mono text-lg font-bold uppercase wrap-break-word">
              {venue}
            </p>
          )
        }
      </article>
    </section>

    {
      localStats && visitingStats ? (
        <section aria-labelledby="comparativa" class="mb-8">
          <h2
            id="comparativa"
            class="mb-4 font-mono text-2xl font-bold uppercase tracking-wider md:text-3xl"
          >
            Comparativa
          </h2>
          <div class="overflow-hidden rounded-md bg-surface shadow-xs">
            <table class="w-full table-fixed border-collapse text-sm">
              <caption class="sr-only">
                Estadísticas de temporada de {match.localTeam} y{" "}
                {match.visitingTeam}
              </caption>
              <thead>
                <tr class="border-b border-line/70">
                  <th
                    scope="col"
                    class="p-3 text-center font-mono text-xs font-bold uppercase tracking-wider wrap-break-word"
                  >
                    {match.localTeam}
                  </th>
                  <th
                    scope="col"
                    class="p-3 text-center text-xs font-bold uppercase tracking-widest text-muted-foreground"
                  >
                    Dato
                  </th>
                  <th
                    scope="col"
                    class="p-3 text-center font-mono text-xs font-bold uppercase tracking-wider wrap-break-word"
                  >
                    {match.visitingTeam}
                  </th>
                </tr>
              </thead>
              <tbody>
                {comparison.map((row) => (
                  <tr class="border-b border-line/40 last:border-b-0">
                    <td class="p-3 text-center font-mono text-base font-bold tabular-nums">
                      {row.get(localStats)}
                    </td>
                    <th
                      scope="row"
                      class="p-3 text-center text-xs font-bold uppercase tracking-wider text-muted-foreground"
                    >
                      {row.label}
                    </th>
                    <td class="p-3 text-center font-mono text-base font-bold tabular-nums">
                      {row.get(visitingStats)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ) : null
    }

    {
      headToHead.length > 0 ? (
        <section aria-labelledby="historial" class="mb-8">
          <h2
            id="historial"
            class="mb-4 font-mono text-2xl font-bold uppercase tracking-wider md:text-3xl"
          >
            Otros enfrentamientos
          </h2>
          <ul class="space-y-3">
            {headToHead.map((other) => {
              const otherStatus = getMatchStatus(other);

              return (
                <li>
                  <a
                    href={`/${tournamentSlug}/match/${getMatchSlug(other)}`}
                    class="flex items-center justify-between gap-4 rounded-md bg-surface p-4 shadow-xs transition-colors duration-150 hover:bg-surface-hover/70"
                  >
                    <span class="min-w-0">
                      <span class="block text-xs font-bold uppercase tracking-wider text-muted-foreground">
                        {other.date}
                      </span>
                      <span class="block font-mono text-sm font-bold uppercase tracking-wide wrap-break-word">
                        {other.localTeam} vs {other.visitingTeam}
                      </span>
                    </span>
                    <span class="shrink-0 font-mono text-xl font-bold tabular-nums">
                      {otherStatus === "upcoming"
                        ? "—"
                        : `${other.localTeamPoints} - ${other.visitingTeamPoints}`}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ) : null
    }

    <section class="rounded-md bg-surface p-6 shadow-xs">
      <MatchStory
        client:load
        status={card.status}
        local={card.local}
        visiting={card.visiting}
        dateLabel={card.dateLabel}
        timeLabel={card.timeLabel}
        venue={card.venue}
        weekLabel={card.weekLabel}
        tournamentLabel={card.tournamentLabel}
        siteLabel={SITE_HOST}
        fileName={`are-we-playing-${slugify(match.localTeam)}-vs-${slugify(match.visitingTeam)}.png`}
      />
    </section>
  </div>
</Layout>
