---
import MatchStory from "@/components/match-story.tsx";
import { SITE_HOST } from "@/constants/site";
import Layout from "@/layouts/Layout.astro";
import type { Match } from "@/types/match";
import type { TeamPosition } from "@/types/team";
import type { Week } from "@/types/week";
import { getMatchesWithWeek } from "@/utils/get-match";
import { MATCH_STATUS_LABEL, getMatchStatus } from "@/utils/get-match-status";
import {
  buildMatchCard,
  getTournamentLabel,
  teamInitials,
} from "@/utils/get-match-card";
import { getTeamsTable } from "@/utils/get-teams-table";
import { safeHttpUrl } from "@/utils/safe-url";
import { getTournaments } from "@/utils/get-tournaments";
import {
  getTournamentSlug,
  requireTournamentBySlug,
} from "@/utils/tournament-slug";
import { getMatchSlug } from "@/utils/match-slug";
import { getTeamSlug } from "@/utils/team-slug";
import { getWeekSlug } from "@/utils/week-slug";
import { slugify } from "@/utils/slugify";
import { format, isValid, parse } from "date-fns";
import { es } from "date-fns/locale";
import { MapPin } from "@lucide/astro";

export async function getStaticPaths() {
  const perTournament = getTournaments().map(async (t) => {
    const tournamentId = t.id.toLowerCase();

    const [matches, teams] = await Promise.all([
      getMatchesWithWeek(tournamentId),
      getTeamsTable(tournamentId),
    ]);

    return matches.map(({ match, week }) => ({
      params: {
        tournament: getTournamentSlug(t),
        match: getMatchSlug(match),
      },
      props: {
        match,
        week,
        localStats: teams.find((t) => t.id === match.localTeamId),
        visitingStats: teams.find((t) => t.id === match.visitingTeamId),
        // Enfrentamientos previos de estos dos equipos dentro del mismo torneo.
        headToHead: matches
          .map(({ match: other }) => other)
          .filter(
            (other) =>
              other.matchId !== match.matchId &&
              [other.localTeamId, other.visitingTeamId].every((teamId) =>
                [match.localTeamId, match.visitingTeamId].includes(teamId),
              ),
          ),
      },
    }));
  });

  return (await Promise.all(perTournament)).flat();
}

interface Props {
  match: Match;
  week?: Week;
  localStats?: TeamPosition;
  visitingStats?: TeamPosition;
  headToHead: Match[];
}

const tournament = requireTournamentBySlug(Astro.params.tournament);
const tournamentSlug = Astro.params.tournament;

const { match, week, localStats, visitingStats, headToHead } = Astro.props;

const card = buildMatchCard({
  tournament,
  match,
  week,
  localStats,
  visitingStats,
});

const { status } = card;
const hasScore = status !== "upcoming";

const [rawDate, rawTime = ""] = match.date.split(" ");
const parsedDate = parse(rawDate, "dd/MM/yyyy", new Date());
const longDate = isValid(parsedDate)
  ? format(parsedDate, "EEEE d 'de' MMMM 'de' yyyy", { locale: es })
  : rawDate;

const teams = [
  { side: card.local, role: "Local" as const, stats: localStats },
  { side: card.visiting, role: "Visitante" as const, stats: visitingStats },
].map(({ side, role, stats }) => ({
  ...side,
  role,
  stats,
  fullName: stats?.name ?? side.name,
  slug: getTeamSlug({ shortName: side.name }),
}));

interface ComparisonRow {
  label: string;
  format: (t: TeamPosition) => string;
  value: (t: TeamPosition) => number;
  lowerIsBetter?: boolean;
}

const comparison: ComparisonRow[] = [
  {
    label: "Posición",
    format: (t) => `#${t.position}`,
    value: (t) => t.position,
    lowerIsBetter: true,
  },
  {
    label: "Récord",
    format: (t) => `${t.wins}W - ${t.losses}L`,
    value: (t) => t.wins,
  },
  {
    label: "Win rate",
    format: (t) => `${t.percentage}%`,
    value: (t) => t.percentage,
  },
  {
    label: "Puntos a favor",
    format: (t) => String(t.goalsFor),
    value: (t) => t.goalsFor,
  },
  {
    label: "Puntos en contra",
    format: (t) => String(t.goalsAgainst),
    value: (t) => t.goalsAgainst,
    lowerIsBetter: true,
  },
  {
    label: "Diferencia",
    format: (t) => `${t.goalDifference > 0 ? "+" : ""}${t.goalDifference}`,
    value: (t) => t.goalDifference,
  },
];

// Porcentaje de la barra que le corresponde al local. Desplaza valores
// negativos (p. ej. diferencia) y reparte a partes iguales si ambos son 0.
function localShare(
  row: ComparisonRow,
  local: TeamPosition,
  visiting: TeamPosition,
) {
  const offset = Math.min(0, row.value(local), row.value(visiting));
  const a = row.value(local) - offset;
  const b = row.value(visiting) - offset;
  const total = a + b;

  if (!Number.isFinite(total) || total === 0) return 50;

  return ((row.lowerIsBetter ? b : a) / total) * 100;
}

const tournamentLabel = getTournamentLabel(tournament);
const venueUrl = safeHttpUrl(match.locationUrl);
const venue = card.venue;

const title = `${match.localTeam} vs ${match.visitingTeam}${hasScore ? ` ${match.localTeamPoints}-${match.visitingTeamPoints}` : ""} | Are We Playing?`;
const description = `${match.localTeam} vs ${match.visitingTeam} · ${longDate}${rawTime ? ` a las ${rawTime}` : ""} · ${venue}. ${tournamentLabel}.`;
---

<Layout
  tournamentSlug={tournamentSlug}
  title={title}
  description={description}
  image={`/${tournamentSlug}/match/${Astro.params.match}/og.png`}
>
  <div class="mx-auto w-full max-w-5xl">
    <div class="mb-6 flex items-center justify-between gap-4">
      <a
        href={week
          ? `/${tournamentSlug}/${getWeekSlug(week)}`
          : `/${tournamentSlug}`}
        class="rounded-md bg-surface px-4 py-2 text-sm font-bold uppercase tracking-wider shadow-xs transition-transform duration-180 hover:bg-surface-hover/70 focus-visible:scale-95"
      >
        ← Regresar
      </a>

      <span
        class={`rounded-md border border-line/70 px-3 py-1 text-xs font-bold uppercase tracking-wider ${
          status === "finished"
            ? "bg-muted text-muted-foreground"
            : "bg-primary text-primary-foreground"
        }`}
      >
        {MATCH_STATUS_LABEL[status]}
      </span>
    </div>

    <header class="mb-8 border-b border-b-line/70 pb-6">
      <p
        class="mb-4 text-xs font-bold uppercase tracking-widest text-muted-foreground"
      >
        {tournamentLabel}{week ? ` · ${week.week}` : ""} · Partido {
          match.matchNumber
        }
      </p>
      <h1
        class="font-mono text-3xl font-bold uppercase tracking-wider text-balance md:text-5xl flex flex-col flex-wrap items-baseline gap-4"
      >
        <div class="flex justify-between items-center w-full">
          <a
            href={`/${tournamentSlug}/teams/${teams[0].slug}`}
            class="hover:underline text-balance"
            transition:name={match.localTeam}>{match.localTeam}</a
          >
          {
            hasScore && (
              <span
                class:list={[
                  "text-muted-foreground bg-muted border border-line/70 px-4 text-center py-1 rounded-md tabular-nums",
                  teams[0].isWinner && "bg-primary! text-primary-foreground",
                ]}
              >
                {teams[0].points}
              </span>
            )
          }
        </div>
        <span class="text-muted-foreground text-3xl">vs</span>
        <div class="flex justify-between items-center w-full">
          <a
            href={`/${tournamentSlug}/teams/${teams[1].slug}`}
            class="hover:underline text-balance"
            transition:name={match.visitingTeam}>{match.visitingTeam}</a
          >
          {
            hasScore && (
              <span
                class:list={[
                  "text-muted-foreground bg-muted border border-line/70 px-4 text-center py-1 rounded-md tabular-nums",
                  teams[1].isWinner && "bg-primary! text-primary-foreground",
                ]}
              >
                {teams[1].points}
              </span>
            )
          }
        </div>
      </h1>
      <div
        class="mt-4 text-sm uppercase tracking-wider text-muted-foreground flex flex-wrap gap-2 justify-between items-center"
      >
        <p>
          {longDate}{rawTime ? ` · ${rawTime} hrs` : ""}
        </p>
        {
          venueUrl ? (
            <a
              href={venueUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex gap-2 items-center wrap-break-word hover:underline"
            >
              <MapPin class="size-4" />
              {venue}
            </a>
          ) : (
            <p class="flex gap-2 items-center wrap-break-word">
              <MapPin class="size-4" />
              {venue}
            </p>
          )
        }
      </div>
    </header>

    {
      localStats && visitingStats ? (
        <section aria-label="Comparativa" class="mb-8 rounded-md">
          <div class="mb-4 flex items-center justify-between gap-4 pb-2 font-mono text-xs font-bold uppercase tracking-wider">
            <span class="flex min-w-0 items-center gap-2">
              <span
                aria-hidden="true"
                class="size-2.5 shrink-0 rounded-full bg-blue-600"
              />
              <span class="truncate">{match.localTeam}</span>
            </span>
            <span class="flex min-w-0 items-center gap-2">
              <span class="truncate">{match.visitingTeam}</span>
              <span
                aria-hidden="true"
                class="size-2.5 shrink-0 rounded-full bg-red-600"
              />
            </span>
          </div>
          <ul
            class="flex flex-col gap-5"
            aria-label={`Estadísticas de temporada de ${match.localTeam} y ${match.visitingTeam}`}
          >
            {comparison.map((row) => {
              const share = localShare(row, localStats, visitingStats);

              return (
                <li>
                  <div class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3">
                    <span class="font-mono text-base font-bold tabular-nums">
                      <span class="sr-only">{match.localTeam}: </span>
                      {row.format(localStats)}
                    </span>
                    <span class="text-center text-xs font-bold uppercase tracking-wider text-muted-foreground">
                      {row.label}
                    </span>
                    <span class="text-right font-mono text-base font-bold tabular-nums">
                      <span class="sr-only">{match.visitingTeam}: </span>
                      {row.format(visitingStats)}
                    </span>
                  </div>
                  <div
                    aria-hidden="true"
                    class="mt-2 flex h-1.5 gap-0.5 overflow-hidden rounded-full bg-muted"
                  >
                    <span
                      class="h-full rounded-l-full bg-blue-600"
                      style={`width: ${share}%`}
                    />
                    <span class="h-full flex-1 rounded-r-full bg-red-600" />
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ) : null
    }

    {
      headToHead.length > 0 ? (
        <section aria-labelledby="historial" class="mb-8">
          <h2
            id="historial"
            class="mb-4 font-mono text-2xl font-bold uppercase tracking-wider md:text-3xl"
          >
            Otros enfrentamientos
          </h2>
          <ul class="space-y-3">
            {headToHead.map((other) => {
              const otherStatus = getMatchStatus(other);

              return (
                <li>
                  <a
                    href={`/${tournamentSlug}/match/${getMatchSlug(other)}`}
                    class="flex items-center justify-between gap-4 rounded-md bg-surface p-4 shadow-xs transition-colors duration-150 hover:bg-surface-hover/70"
                  >
                    <span class="min-w-0">
                      <span class="block text-xs font-bold uppercase tracking-wider text-muted-foreground">
                        {other.date}
                      </span>
                      <span class="block font-mono text-sm font-bold uppercase tracking-wide wrap-break-word">
                        {other.localTeam} vs {other.visitingTeam}
                      </span>
                    </span>
                    <span class="shrink-0 font-mono text-xl font-bold tabular-nums">
                      {otherStatus === "upcoming"
                        ? "—"
                        : `${other.localTeamPoints} - ${other.visitingTeamPoints}`}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ) : null
    }
    <hr class="mb-6" />
    <MatchStory
      client:load
      status={card.status}
      local={card.local}
      visiting={card.visiting}
      dateLabel={card.dateLabel}
      timeLabel={card.timeLabel}
      venue={card.venue}
      weekLabel={card.weekLabel}
      tournamentLabel={card.tournamentLabel}
      siteLabel={SITE_HOST}
      fileName={`are-we-playing-${slugify(match.localTeam)}-vs-${slugify(match.visitingTeam)}.png`}
    />
  </div>
</Layout>
