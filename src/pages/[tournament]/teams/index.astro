---
import Layout from "@/layouts/Layout.astro";
import SelectDivision from "@/components/SelectDivision.astro";
import StandingsLadder from "@/components/StandingsLadder.astro";
import { getTournamentLabel } from "@/utils/get-match-card";
import { getStandings } from "@/utils/get-standings";
import { getTournaments } from "@/utils/get-tournaments";
import {
  getTournamentSlug,
  requireTournamentBySlug,
} from "@/utils/tournament-slug";

export function getStaticPaths() {
  return getTournaments().map((t) => ({
    params: {
      tournament: getTournamentSlug(t),
    },
  }));
}

const tournament = requireTournamentBySlug(Astro.params.tournament);
const tournamentSlug = Astro.params.tournament;
const tournamentId = tournament.id.toLowerCase();
const tournamentLabel = getTournamentLabel(tournament);

const { teams, hasStarted } = await getStandings(tournament);
---

<Layout
  tournamentSlug={tournamentSlug}
  title={`Tabla | ${tournamentLabel} | Are We Playing?`}
  description={`Tabla de posiciones de la liga ABE: ${tournamentLabel}.`}
>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-6 md:gap-8">
    <div class="flex flex-wrap items-center gap-3 md:hidden">
      <label
        for="division-mobile"
        class="text-xs font-bold uppercase tracking-widest text-muted-foreground"
      >
        Division:
      </label>
      <SelectDivision id="division-mobile" defaultSelected={tournamentSlug} />
    </div>

    <header class="border-b border-line/70 pb-4">
      <h1
        class="mb-4 font-mono text-4xl font-bold uppercase tracking-tight md:text-6xl"
      >
        Tabla
      </h1>
      <p
        class="mt-2 text-sm font-bold uppercase tracking-wider text-muted-foreground tabular-nums"
      >
        {tournamentLabel}
        <span aria-hidden="true"> · </span>
        <span class="whitespace-nowrap">{teams.length}&nbsp;equipos</span>
      </p>
    </header>

    {
      teams.length === 0 ? (
        <p class="text-base">
          Aún no hay equipos registrados en este torneo.{" "}
          <a href="/teams" class="font-bold underline underline-offset-4">
            Ver todos los equipos
          </a>
        </p>
      ) : (
        <>
          {hasStarted ? null : (
            <p class="text-sm text-muted-foreground md:text-base">
              Aún no se juega ningún partido en este torneo: los equipos van en
              orden alfabético hasta que haya resultados.
            </p>
          )}
          <StandingsLadder
            teams={teams}
            hasStarted={hasStarted}
            tournamentId={tournamentId}
          />
        </>
      )
    }
  </div>
</Layout>
