---
import BackLink from "@/components/BackLink.astro";
import Layout from "@/layouts/Layout.astro";
import { getTeamsTable } from "@/utils/get-teams-table";
import { getTournaments } from "@/utils/get-tournaments";
import {
  getTournamentSlug,
  requireTournamentBySlug,
} from "@/utils/tournament-slug";
import { getTeamBySlug, getTeamSlug } from "@/utils/team-slug";
import TeamCrest from "@/components/TeamCrest.astro";
import TeamSchedule from "@/components/TeamSchedule.astro";
import FavoriteButton from "@/components/favorite-button.tsx";
import ShareButton from "@/components/share-button.tsx";
import { getTeamLogo } from "@/utils/get-team-logo";
import { getLogoColor } from "@/utils/get-logo-color";
import { getTeamStats, type TeamStats } from "@/utils/team-stats";

export async function getStaticPaths() {
  const params = getTournaments().map(async (t) => {
    const teams = await getTeamsTable(t.id);

    return teams.map((team) => ({
      params: {
        tournament: getTournamentSlug(t),
        team: getTeamSlug(team),
      },
    }));
  });

  return (await Promise.all(params)).flat();
}

const tournament = requireTournamentBySlug(Astro.params.tournament);
const tournamentSlug = Astro.params.tournament;
const tournamentId = tournament.id.toLowerCase();

const team = await getTeamBySlug({
  tournamentId,
  slug: Astro.params.team,
});

// getStaticPaths sólo genera slugs válidos, así que llegar aquí sin equipo
// significa que el índice de slugs y los datos dejaron de coincidir.
if (!team) {
  throw new Error(
    `No existe el equipo "${Astro.params.team}" en el torneo "${tournamentSlug}".`,
  );
}

const stats = getTeamStats(team);
const logo = getTeamLogo({ tournamentId, teamId: team.id });
// El color del escudo es el primario de toda la página del equipo (encabezado,
// boletos, filtros); sin escudo (o sin color en él) se queda el color de la marca.
// `getLogoColor` ya lo oscurece para que el blanco se lea encima, así que el texto
// sobre el primario también pasa a blanco en lugar del casi negro de la marca.
const logoColor = await getLogoColor({ tournamentId, teamId: team.id });
const teamTheme = logoColor
  ? {
      "--primary": logoColor,
      "--primary-foreground": "#fff",
      "--highlight-foreground": "#fff",
    }
  : undefined;

// El lugar de cada estadística entre los equipos del torneo, como en la NBA.
// Los que aún no juegan (promedio null) no cuentan.
const leagueStats = (await getTeamsTable(tournamentId)).map(getTeamStats);
const rankOf = (key: keyof TeamStats, higherIsBetter = true) => {
  const own = stats[key];
  if (own === null) return null;

  const better = leagueStats.filter(({ [key]: value }) =>
    value === null ? false : higherIsBetter ? value > own : value < own,
  );
  return better.length + 1;
};

const average = new Intl.NumberFormat("es-MX", {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const signed = new Intl.NumberFormat("es-MX", {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
  signDisplay: "exceptZero",
});
const integer = new Intl.NumberFormat("es-MX", { signDisplay: "exceptZero" });
const formatAverage = (value: number | null, format = average) =>
  value === null ? "—" : format.format(value);

const statColumns = [
  {
    label: "PTS",
    name: "Puntos a favor por partido",
    rank: rankOf("pointsForPerGame"),
    value: formatAverage(stats.pointsForPerGame),
    detail: `${team.goalsFor} total`,
  },
  {
    label: "PTS C",
    name: "Puntos en contra por partido",
    rank: rankOf("pointsAgainstPerGame", false),
    value: formatAverage(stats.pointsAgainstPerGame),
    detail: `${team.goalsAgainst} total`,
  },
  {
    label: "DIF",
    name: "Diferencia de puntos por partido",
    rank: rankOf("differentialPerGame"),
    value: formatAverage(stats.differentialPerGame, signed),
    detail: `${integer.format(team.goalDifference)} total`,
  },
  {
    label: "WIN %",
    name: "Porcentaje de victorias",
    rank: team.position,
    value: `${team.percentage}%`,
    detail: `${team.wins}-${team.losses}`,
  },
];
---

<Layout
  tournamentSlug={tournamentSlug}
  title={`Calendario | ${team.shortName} | Are We Playing?`}
  description={`Calendario de partidos de basketball de ${team.shortName} en la liga ABE ${tournament.category} División ${tournament.division} ${tournament.conference ? `(${tournament.conference})` : ""}.`}
  icon={{
    href: `/logos/${tournamentId.toUpperCase()}/${team.id}.avif`,
    type: "image/avif",
  }}
>
  <div class="p-4 md:p-8" style={teamTheme}>
    <div class="mx-auto flex max-w-7xl flex-col">
      <BackLink
        href={`/${tournamentSlug}/teams`}
        class="mb-6 w-fit rounded-md bg-surface px-4 py-2 tracking-wider shadow-xs transition-transform duration-180 hover:bg-surface-hover/70 focus:scale-95"
      >
        ← REGRESAR
      </BackLink>

      <header
        class="relative mb-8 overflow-hidden rounded-md bg-banner text-primary-foreground shadow-xs"
        style={logoColor ? { "--banner": logoColor } : undefined}
      >
        {/* El círculo de media cancha, como el fondo del encabezado de la NBA. */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -top-40 left-10 size-80 rounded-full border-[1.5rem] border-primary-foreground/8"
        >
        </div>

        <div
          class="relative grid gap-6 p-6 md:p-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-x-10"
        >
          <div class="flex min-w-0 items-center gap-4 md:gap-6">
            <TeamCrest
              logo={logo}
              initials={team.shortName.split(" ")[0].substring(0, 3)}
              class="size-16 text-2xl md:size-24 md:text-3xl"
            />
            <div class="@container min-w-0 flex-1">
              <h1
                class="font-mono text-3xl font-bold uppercase tracking-wider text-balance wrap-break-word md:text-4xl"
              >
                <span transition:name={team.shortName}>{team.shortName}</span>
              </h1>
              {/* Astro quita el espacio entre los <span> y la línea no tiene
              dónde partirse: en columnas angostas se apila y pierde el "|". */}
              <p class="mt-1 flex flex-col text-sm tabular-nums text-primary-foreground/85 @min-[16rem]:flex-row @min-[16rem]:gap-x-2 md:text-base">
                <span class="whitespace-nowrap">
                  {team.wins}W - {team.losses}L
                </span>
                <span aria-hidden="true" class="hidden @min-[16rem]:inline">|</span>
                <span class="whitespace-nowrap">
                  #{team.position} en la tabla
                </span>
              </p>
            </div>
          </div>

          {/* Bajo el nombre y no en medio como en la NBA: los nombres largos
          ("ANÁHUAC SUR") no dejan espacio para tres columnas. */}
          <div
            class="flex flex-wrap gap-3 lg:col-start-1 lg:row-start-2"
          >
            <FavoriteButton client:load id={team.id} variant="banner" />
            <ShareButton
              client:load
              variant="banner"
              title={`${team.shortName} | Are We Playing?`}
              text={`Mira el calendario de partidos de ${team.shortName}`}
            />
          </div>

          <dl
            id="team-stats"
            aria-label="Estadísticas y lugar en el torneo"
            class="grid scroll-mt-28 grid-cols-4 divide-x divide-primary-foreground/25 border-t border-primary-foreground/25 pt-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:border-t-0 lg:pt-0"
          >
            {
              statColumns.map(({ label, name, rank, value, detail }) => (
                <div class="flex min-w-0 flex-col items-center px-2 text-center md:px-5">
                  <dt class="font-mono text-xs font-bold uppercase tracking-wider md:text-sm">
                    <abbr title={name} class="no-underline">
                      {label}
                    </abbr>
                    <span class="sr-only">: {name}</span>
                  </dt>
                  <dd class="mt-1 font-mono text-lg font-bold leading-none tabular-nums md:text-2xl">
                    {rank === null ? (
                      "—"
                    ) : (
                      <>
                        {rank}
                        <span class="align-super text-xs">º</span>
                        <span class="sr-only"> lugar</span>
                      </>
                    )}
                  </dd>
                  <dd class="mt-1 text-sm font-bold tabular-nums">{value}</dd>
                  <dd class="text-xs tabular-nums text-primary-foreground/75">
                    {detail}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </header>

      {/* Players Section */}
