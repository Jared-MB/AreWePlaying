  description={`Calendario de partidos de basketball de ${team.shortName} en la liga ABE ${tournament.category} División ${tournament.division} ${tournament.conference ? `(${tournament.conference})` : ""}.`}
  icon={{
    href: `/logos/${tournamentId.toUpperCase()}/${team.id}.avif`,
    type: "image/avif",
