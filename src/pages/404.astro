---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main
    class="container mx-auto h-[calc(100dvh-5rem)] grid place-content-center gap-8"
  >
    <h2 class="text-center text-6xl font-mono font-medium">404 - NOT FOUND</h2>
    <div class="flex items-center flex-col gap-2">
      <p class="text-center">No encontramos lo que estabas buscando</p>
      <a href="/" class="text-center text-primary hover:underline">
        Regresa al inicio
      </a>
    </div>
  </main>
</Layout>
