---
import AreWePlaying from "@/components/AreWePlaying.astro";
import TodayMatches from "@/components/TodayMatches.astro";
import TopPerformers from "@/components/TopPerformers.astro";
import ScrollToFavoriteMatch from "@/components/ScrollToFavoriteMatch.astro";

import { getTournaments } from "@/utils/get-tournaments";
import HeadlessLayout from "@/layouts/HeadlessLayout.astro";
import Footer from "@/components/Footer.astro";
import { Toaster } from "@/components/sonner";

const tournaments = getTournaments();
---

<HeadlessLayout>
  <div class="flex flex-col">
    <div data-page-header class="sticky top-0 pt-8 md:pt-12 bg-background z-10">
      <div class="container mx-auto px-6 md:px-4 flex flex-col gap-6 md:gap-12">
        <AreWePlaying />
        <hr />
      </div>
    </div>
    <main
      id="contenido"
      class="flex flex-col gap-12 container mx-auto px-6 md:px-4 py-8 md:py-12"
    >
      <nav
        id="divisiones"
        aria-label="Divisiones"
        class="scroll-mt-(--page-header-h,0px)"
      >
        {
          (
            // biome-ignore lint/a11y/noRedundantRoles: sin bullets Safari deja de anunciar la lista
            <ul role="list" class="flex flex-wrap gap-3 md:gap-6 items-center">
              {tournaments.map((t) => (
                <li>
                  <a
                    href={`/${t.id.toLowerCase()}`}
                    class="block bg-surface rounded-md px-4 py-2 shadow-xs hover:bg-surface-hover/70 focus-visible:scale-95 transition-transform duration-180"
                  >
                    División {t.division} {t.category}{" "}
                    {t.conference ? `· ${t.conference}` : null}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </nav>
      <div
        class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_30%] gap-12 relative"
      >
        <ScrollToFavoriteMatch>
          <TodayMatches server:defer>
            <div slot="fallback" class="space-y-6" aria-busy="true">
              <span class="sr-only">Cargando partidos de hoy…</span>
              <div
                class="h-10 w-64 animate-pulse bg-muted motion-reduce:animate-none rounded-md"
              >
              </div>
              {
                Array.from({ length: 3 }, () => (
                  <div class="h-32 animate-pulse bg-surface shadow-xs motion-reduce:animate-none rounded-md" />
                ))
              }
            </div>
          </TodayMatches>
        </ScrollToFavoriteMatch>
        <section
          id="top-performers"
          aria-labelledby="top-performers-heading"
          class="min-w-0"
        >
          <h2
            id="top-performers-heading"
            class="mb-6 py-4 font-mono text-3xl md:text-4xl font-bold uppercase tracking-tight scroll-mt-8"
          >
            Mejores equipos
          </h2>
          <TopPerformers server:defer>
            <div slot="fallback" class="space-y-8" aria-busy="true">
              <span class="sr-only">Cargando mejores equipos…</span>
              {
                Array.from({ length: 3 }, () => (
                  <div class="h-40 animate-pulse rounded-md bg-muted motion-reduce:animate-none" />
                ))
              }
            </div>
          </TopPerformers>
        </section>
      </div>
    </main>
  </div>
  <Footer />
  <Toaster client:load />
</HeadlessLayout>

<script>
  // Expone la altura del encabezado sticky como `--page-header-h` para que los
  // headers de cada torneo se peguen justo debajo de él.
  let observer: ResizeObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();

    const $header = document.querySelector<HTMLElement>("[data-page-header]");
    if (!$header) return;

    observer = new ResizeObserver(() => {
      document.documentElement.style.setProperty(
        "--page-header-h",
        `${$header.offsetHeight}px`,
      );
    });
    observer.observe($header);
  });
</script>
