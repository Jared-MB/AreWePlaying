---
import AreWePlaying from "@/components/AreWePlaying.astro";
import TodayMatches from "@/components/TodayMatches.astro";
import TopPerformers from "@/components/TopPerformers.astro";
import ScrollToFavoriteMatch from "@/components/ScrollToFavoriteMatch.astro";

import { getTournaments } from "@/utils/get-tournaments";
import { getTournamentSlug } from "@/utils/tournament-slug";
import HeadlessLayout from "@/layouts/HeadlessLayout.astro";
import Footer from "@/components/Footer.astro";
import TeamsMenu from "@/components/TeamsMenu.astro";
import { Toaster } from "@/components/sonner";
import DivisionLabel from "@/components/DivisionLabel.astro";
import ExternalLink from "@lucide/astro/icons/external-link";
import {
  SECTION_HEADING_CLASS,
  SECTION_LINK_CLASS,
} from "@/constants/typography";
import FavoriteAnswer, {
  FAVORITE_ANSWER_DETAIL_ID,
  TEAM_ANSWERS_DATA_ID,
} from "@/components/favorite-answer";
import { getTeamAnswers } from "@/utils/get-team-answers";

const tournaments = getTournaments();
// `<` escapado para que ningún nombre pueda cerrar el <script> que lo lleva.
const teamAnswersJson = JSON.stringify(await getTeamAnswers()).replaceAll(
  "<",
  "\\u003c",
);

// Los datos son una copia: se muestra la fecha de la más reciente para no
// aparentar que los marcadores son en vivo.
const snapshotTime = Math.max(
  ...tournaments.map((t) => Date.parse(t.updated_at)),
);
const snapshotDate = Number.isFinite(snapshotTime)
  ? new Intl.DateTimeFormat("es-MX", {
      dateStyle: "long",
      timeZone: "America/Mexico_City",
    }).format(snapshotTime)
  : null;
---

<HeadlessLayout>
  <div class="flex flex-col">
    <header
      data-page-header
      class="sticky top-0 z-20 border-b border-line/70 bg-background px-4 py-3"
    >
      <div
        data-dropdown-menu
        class="container mx-auto flex items-center justify-between gap-4"
      >
        <TeamsMenu />
        <span
          aria-hidden="true"
          data-page-wordmark
          translate="no"
          class="font-pixel text-xl font-bold uppercase opacity-0 transition-opacity duration-200 motion-reduce:transition-none data-[visible=true]:opacity-100"
        >
          Are We Playing?
        </span>
      </div>
    </header>
    <div
      class="container mx-auto px-6 md:px-4 pt-8 md:pt-12 flex flex-col gap-6 md:gap-12"
    >
      <div id="favorite-answer" class="flex flex-col gap-5">
        <AreWePlaying>
          <FavoriteAnswer slot="answer" client:load />
        </AreWePlaying>
        <div
          id={FAVORITE_ANSWER_DETAIL_ID}
          class="flex flex-col items-start gap-4 empty:hidden"
        />
      </div>
      <script
        is:inline
        type="application/json"
        id={TEAM_ANSWERS_DATA_ID}
        set:html={teamAnswersJson}
      />
      <script is:inline>
        // Antes del primer pintado: si hay favoritos, la isla reserva el lugar
        // de la respuesta junto al H1 para que no brinque al hidratar. La llave
        // debe coincidir con LOCAL_STORAGE_FAVORITES_KEY.
        try {
          const favorites = JSON.parse(
            localStorage.getItem("favorites") || "[]",
          );
          if (Array.isArray(favorites) && favorites.length > 0) {
            document.getElementById("favorite-answer").dataset.hasFavorites =
              "";
          }
        } catch {}
      </script>
      <hr />
    </div>
    <main
      id="contenido"
      class="flex flex-col gap-12 container mx-auto px-6 md:px-4 py-8 md:py-12"
    >
      <div class="flex flex-col gap-4">
        <nav
          id="divisiones"
          aria-label="Divisiones"
          class="scroll-mt-(--page-header-h,0px)"
        >
          <ul
            // biome-ignore lint/a11y/noRedundantRoles: sin bullets Safari deja de anunciar la lista
            role="list"
            class="grid md:grid-cols-2 gap-3 md:gap-6 lg:grid-cols-4"
          >
            {
              tournaments.map((t) => (
                <li class="ticket-edge">
                  <a
                    href={`/${getTournamentSlug(t)}`}
                    class="ticket-notch-x flex h-full min-h-20 overflow-hidden rounded-md bg-surface transition-[background-color] [--notch:8px] hover:bg-surface-hover focus-visible:outline-offset-[-3px]"
                  >
                    <DivisionLabel tournament={t} size="lg" class="w-full" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="text-sm text-muted-foreground text-pretty">
          {snapshotDate ? `Datos de la Liga ABE al ${snapshotDate}. ` : null}{
            " "
          }
          <a
            href="/acerca"
            class="touch-hitbox font-bold text-foreground underline decoration-primary decoration-2 underline-offset-4 hover:bg-primary hover:text-highlight-foreground"
            >Conoce el proyecto</a
          >
        </p>
      </div>
      <div
        class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_30%] gap-12 relative"
      >
        <ScrollToFavoriteMatch>
          <TodayMatches server:defer>
            <div slot="fallback" class="space-y-6" aria-busy="true">
              <span class="sr-only">Cargando partidos de hoy…</span>
              <div
                class="h-10 w-64 animate-pulse bg-muted motion-reduce:animate-none rounded-md"
              >
              </div>
              {
                Array.from({ length: 3 }, () => (
                  <div class="h-32 animate-pulse bg-surface shadow-xs motion-reduce:animate-none rounded-md" />
                ))
              }
            </div>
          </TodayMatches>
        </ScrollToFavoriteMatch>
        <div class="space-y-6">
          <section
            id="top-performers"
            aria-labelledby="top-performers-heading"
            class="min-w-0"
          >
            <h2
              id="top-performers-heading"
              class:list={[
                "mb-6 scroll-mt-[calc(var(--page-header-h,0px)+1rem)]",
                SECTION_HEADING_CLASS,
              ]}
            >
              Mejores equipos
            </h2>
            <TopPerformers />
          </section>
          <div class="flex justify-end">
            <a
              href="https://2025-2026.areweplaying.com"
              target="_blank"
              rel="noreferrer noopener"
              class:list={[SECTION_LINK_CLASS, "inline-flex items-center gap-1.5"]}
              >Ver temporada anterior<ExternalLink
                aria-hidden="true"
                class="size-4"
              /><span class="sr-only"> (abre en una pestaña nueva)</span></a
            >
          </div>
        </div>
      </div>
    </main>
  </div>
  <Footer />
  <Toaster client:load />
</HeadlessLayout>

<script>
  // El header (Equipos + marca) se queda fijo y delgado. El "Are We Playing?"
  // grande vive en el flujo normal; cuando se va bajo el header, la marca chica
  // del header aparece. Se expone `--page-header-h`: la altura fija, para que los
  // headers de cada torneo se peguen justo debajo.
  let resizeObserver: ResizeObserver | undefined;
  let titleObserver: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    resizeObserver?.disconnect();
    titleObserver?.disconnect();

    const $header = document.querySelector<HTMLElement>("[data-page-header]");
    if (!$header) return;

    const update = () => {
      document.documentElement.style.setProperty(
        "--page-header-h",
        `${$header.offsetHeight}px`,
      );
    };
    resizeObserver = new ResizeObserver(update);
    resizeObserver.observe($header);

    const $title = document.querySelector<HTMLElement>("h1");
    const $wordmark = document.querySelector<HTMLElement>(
      "[data-page-wordmark]",
    );
    if (!$title || !$wordmark) return;

    titleObserver = new IntersectionObserver(
      ([entry]) => {
        $wordmark.dataset.visible = String(!entry.isIntersecting);
      },
      { rootMargin: `-${$header.offsetHeight}px 0px 0px 0px` },
    );
    titleObserver.observe($title);
  });
</script>
