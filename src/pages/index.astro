---
import Layout from "@/layouts/Layout.astro";
import tournaments from "@/assets/tournaments.json" with { type: "json" };
import AreWePlaying from "@/components/AreWePlaying.astro";
import { getTeamsTable } from "@/utils/get-teams-table";

const topTeamsPromise = tournaments.map(async (t) => {
  const teams = await getTeamsTable(t.id);

  const sortedTeams = teams.toSorted((a, b) => a.position - b.position);
  return {
    tournamentId: t.id,
    team: sortedTeams[0],
  };
});

const topTeams = await Promise.all(topTeamsPromise);
---

<Layout>
  <AreWePlaying />
  <main class="grid xl:grid-cols-2 gap-6">
    {
      tournaments.map((t) => {
        const team = topTeams.find((team) => team.tournamentId === t.id)?.team;

        return (
          <a href={`/${t.id.toLowerCase()}/`} class="group mb-8 block">
            <div class="border-4 border-foreground bg-primary shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
              <div class="border-b-4 border-foreground bg-background px-6 py-3">
                <div class="font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground flex justify-between items-center">
                  <div class="flex items-center gap-4">
                    <div class="bg-primary font-mono text-primary-foreground px-2 py-1 text-center grid place-content-center shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                      #1
                    </div>
                    <span class="text-pretty">{team?.shortName}</span>
                  </div>
                  <div class="font-mono font-bold hidden md:inline-block">
                    {team?.wins}W - {team?.losses}L
                  </div>
                </div>
              </div>
              <div class="grid gap-0 md:grid-cols-[1fr_auto]">
                <div class="p-8">
                  <h2 class="mb-6 font-mono text-4xl font-bold uppercase leading-none tracking-tight text-primary-foreground md:text-6xl">
                    División {t.division}
                  </h2>
                  <div class="flex flex-col md:flex-row gap-2 md:gap-12">
                    <div class="font-mono text-xl uppercase tracking-wider text-background/70">
                      {t.category}
                    </div>
                  </div>
                </div>
                {t.conference ? (
                  <div class="flex items-center justify-center border-l-4 border-foreground bg-background p-8 md:w-48">
                    <div class="hidden md:flex h-24 w-24 items-center justify-center border-4 border-foreground bg-primary text-5xl font-bold text-primary-foreground shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
                      {t?.conference?.at(0)}
                    </div>
                    <div class="flex md:hidden h-24 w-fit px-6 items-center justify-center border-4 border-foreground bg-primary text-5xl font-bold text-primary-foreground shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
                      {t?.conference}
                    </div>
                  </div>
                ) : null}
              </div>
            </div>
          </a>
        );
      })
    }
  </main>
</Layout>
