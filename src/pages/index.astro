---
import AreWePlaying from "@/components/AreWePlaying.astro";
import TodayMatches from "@/components/TodayMatches.astro";
import TopPerformers from "@/components/TopPerformers.astro";
import ScrollToFavoriteMatch from "@/components/ScrollToFavoriteMatch.astro";

import { getTournaments } from "@/utils/get-tournaments";
import { getTournamentSlug } from "@/utils/tournament-slug";
import HeadlessLayout from "@/layouts/HeadlessLayout.astro";
import Footer from "@/components/Footer.astro";
import TeamsMenu from "@/components/TeamsMenu.astro";
import { Toaster } from "@/components/sonner";

const tournaments = getTournaments();
---

<HeadlessLayout>
  <div class="flex flex-col">
    <div
      data-page-header
      class="sticky top-(--page-header-top,0px) bg-background z-20"
    >
      <header
        data-page-header-teams
        class="border-b border-line/70 bg-background py-6 px-4"
      >
        <div data-dropdown-menu class="container mx-auto">
          <TeamsMenu />
        </div>
      </header>
      <div
        class="container mx-auto px-6 md:px-4 pt-8 md:pt-12 flex flex-col gap-6 md:gap-12"
      >
        <AreWePlaying />
        <hr />
      </div>
    </div>
    <main
      id="contenido"
      class="flex flex-col gap-12 container mx-auto px-6 md:px-4 py-8 md:py-12"
    >
      <nav
        id="divisiones"
        aria-label="Divisiones"
        class="scroll-mt-(--page-header-h,0px)"
      >
        {
          (
            // biome-ignore lint/a11y/noRedundantRoles: sin bullets Safari deja de anunciar la lista
            <ul role="list" class="flex flex-wrap gap-3 md:gap-6 items-center">
              {tournaments.map((t) => (
                <li class="ticket-edge">
                  <a
                    href={`/${getTournamentSlug(t)}`}
                    class="ticket-notch-x flex items-stretch overflow-hidden rounded-md bg-surface transition-[background-color] [--notch:6px] hover:bg-surface-hover focus-visible:outline-offset-[-3px]"
                  >
                    <span
                      class="grid min-w-11 place-items-center border-r-2 border-dashed border-highlight-foreground/40 bg-primary px-2.5 font-pixel text-xl font-bold text-highlight-foreground"
                      translate="no"
                    >
                      <span class="sr-only">División </span>{t.division}
                    </span>
                    <span class="flex min-h-11 flex-col justify-center gap-0.5 py-2 pr-4 pl-3">
                      <span
                        aria-hidden="true"
                        class="text-[10px] uppercase tracking-wider text-muted-foreground"
                      >
                        División
                      </span>
                      <span class="whitespace-nowrap text-sm font-bold uppercase">
                        {t.category}
                        {t.conference ? (
                          <span class="font-normal text-muted-foreground">
                            {" "}
                            · {t.conference}
                          </span>
                        ) : null}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </nav>
      <div
        class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_30%] gap-12 relative"
      >
        <ScrollToFavoriteMatch>
          <TodayMatches server:defer>
            <div slot="fallback" class="space-y-6" aria-busy="true">
              <span class="sr-only">Cargando partidos de hoy…</span>
              <div
                class="h-10 w-64 animate-pulse bg-muted motion-reduce:animate-none rounded-md"
              >
              </div>
              {
                Array.from({ length: 3 }, () => (
                  <div class="h-32 animate-pulse bg-surface shadow-xs motion-reduce:animate-none rounded-md" />
                ))
              }
            </div>
          </TodayMatches>
        </ScrollToFavoriteMatch>
        <div class="space-y-6">
          <section
            id="top-performers"
            aria-labelledby="top-performers-heading"
            class="min-w-0"
          >
            <h2
              id="top-performers-heading"
              class="mb-6 py-4 font-mono text-3xl md:text-4xl font-bold uppercase tracking-tight scroll-mt-8"
            >
              Mejores equipos
            </h2>
            <TopPerformers />
          </section>
          <div class="flex justify-end">
            <a
              href="https://2025-2026.areweplaying.com"
              target="_blank"
              rel="noreferrer noopener"
              class="text-sm hover:underline">Ver temporada anterior</a
            >
          </div>
        </div>
      </div>
    </main>
  </div>
  <Footer />
  <Toaster client:load />
</HeadlessLayout>

<script>
  // El header "Equipos" solo se ve al inicio: el contenedor sticky se pega con un
  // `top` negativo igual a la altura de "Equipos", así que éste se va con el scroll
  // y "Are We Playing?" se queda fijo. Se expone:
  //  - `--page-header-top`: ese `top` negativo.
  //  - `--page-header-h`: la altura que queda fija, para que los headers de cada
  //    torneo se peguen justo debajo.
  let observer: ResizeObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();

    const $header = document.querySelector<HTMLElement>("[data-page-header]");
    const $teams = document.querySelector<HTMLElement>(
      "[data-page-header-teams]",
    );
    if (!$header || !$teams) return;

    const update = () => {
      const teamsHeight = $teams.offsetHeight;
      const { style } = document.documentElement;
      style.setProperty("--page-header-top", `${-teamsHeight}px`);
      style.setProperty(
        "--page-header-h",
        `${$header.offsetHeight - teamsHeight}px`,
      );
    };

    observer = new ResizeObserver(update);
    observer.observe($header);
    observer.observe($teams);
  });
</script>
