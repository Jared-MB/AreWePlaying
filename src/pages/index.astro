---
import AreWePlaying from "@/components/AreWePlaying.astro";
import TopPerformers from "@/components/TopPerformers.astro";

import { getTournaments } from "@/utils/get-tournaments";
import { getTournamentSlug } from "@/utils/tournament-slug";
import HeadlessLayout from "@/layouts/HeadlessLayout.astro";
import Footer from "@/components/Footer.astro";
import { Toaster } from "@/components/sonner";
import { CURRENT_SEASON, LATEST_SEASON } from "@/constants/season";
import { CURRENT_SEASON_URL } from "@/constants/site";
import { ArrowRight } from "lucide-preact";

const tournaments = getTournaments();
---

<HeadlessLayout>
  <div class="flex flex-col">
    <div data-page-header class="sticky top-0 pt-8 md:pt-12 bg-background z-20">
      <div class="container mx-auto px-6 md:px-4 flex flex-col gap-6 md:gap-12">
        <AreWePlaying />
        <hr />
      </div>
    </div>
    <main
      id="contenido"
      class="flex flex-col gap-12 container mx-auto px-6 md:px-4 py-8 md:py-12"
    >
      <nav
        id="divisiones"
        aria-label="Divisiones"
        class="scroll-mt-(--page-header-h,0px)"
      >
        {
          (
            // biome-ignore lint/a11y/noRedundantRoles: sin bullets Safari deja de anunciar la lista
            <ul role="list" class="flex flex-wrap gap-3 md:gap-6 items-center">
              {tournaments.map((t) => (
                <li>
                  <a
                    href={`/${getTournamentSlug(t)}`}
                    class="block bg-surface rounded-md px-4 py-2 shadow-xs hover:bg-surface-hover/70 focus-visible:scale-95 transition-transform duration-180"
                  >
                    División {t.division} {t.category}{" "}
                    {t.conference ? `· ${t.conference}` : null}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </nav>
      <div
        class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_30%] gap-12 relative"
      >
        <section
          aria-labelledby="past-season"
          class="border-4 border-frame bg-background shadow-[8px_8px_0px_0px_var(--color-hard-shadow)] h-fit mt-6"
        >
          <div
            class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b-4 border-frame bg-inverse px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider text-inverse-foreground"
          >
            <p>Temporada archivada</p>
            <p class="opacity-70">No hay más partidos por mostrar</p>
          </div>
          <div class="p-6 md:p-8">
            <h2
              id="past-season"
              class="font-mono text-4xl font-bold uppercase leading-none tracking-tighter tabular-nums sm:text-5xl md:text-7xl"
            >
              {CURRENT_SEASON}
            </h2>
            <p class="mt-6 border-t-4 border-frame pt-6 text-pretty">
              Esta temporada ya terminó: aquí sólo quedan guardadas sus jornadas
              y sus resultados.
            </p>
            <div
              class="mt-8 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8"
            >
              <a
                href={CURRENT_SEASON_URL}
                class="group inline-flex items-center gap-3 border-4 border-frame bg-primary px-6 py-4 font-mono text-sm font-bold uppercase tracking-wider text-primary-foreground shadow-[6px_6px_0px_0px_var(--color-hard-shadow)] outline-none transition-[translate,box-shadow] duration-180 hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0px_0px_var(--color-hard-shadow)] focus-visible:ring-[3px] focus-visible:ring-ring/50 motion-reduce:transition-none touch-manipulation"
              >
                Ir a la temporada {LATEST_SEASON}
                <ArrowRight
                  class="size-5 shrink-0 transition-transform duration-180 group-hover:translate-x-1 motion-reduce:transition-none"
                  aria-hidden="true"
                />
              </a>
              <a
                href="#divisiones"
                class="font-mono text-sm font-bold uppercase tracking-wider underline decoration-2 underline-offset-4 hover:text-primary"
              >
                Ver las jornadas de {CURRENT_SEASON}
              </a>
            </div>
          </div>
        </section>
        <section
          id="top-performers"
          aria-labelledby="top-performers-heading"
          class="min-w-0"
        >
          <h2
            id="top-performers-heading"
            class="mb-6 py-4 font-mono text-3xl md:text-4xl font-bold uppercase tracking-tight scroll-mt-8"
          >
            Mejores equipos
          </h2>
          <TopPerformers />
        </section>
      </div>
    </main>
  </div>
  <Footer />
  <Toaster client:load />
</HeadlessLayout>

<script>
  // Expone la altura del encabezado sticky como `--page-header-h` para que los
  // headers de cada torneo se peguen justo debajo de él.
  let observer: ResizeObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();

    const $header = document.querySelector<HTMLElement>("[data-page-header]");
    if (!$header) return;

    observer = new ResizeObserver(() => {
      document.documentElement.style.setProperty(
        "--page-header-h",
        `${$header.offsetHeight}px`,
      );
    });
    observer.observe($header);
  });
</script>
