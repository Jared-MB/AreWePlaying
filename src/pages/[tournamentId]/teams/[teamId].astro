---
import Layout from "@/layouts/Layout.astro";
import { getTeamsTable } from "@/utils/get-teams-table";
import { getTournaments } from "@/utils/get-tournaments";
import { getTeam } from "@/utils/get-team";
import PastMatches from "@/components/PastMatches.astro";
import UpcomingMatches from "@/components/UpcomingMatches.astro";

export async function getStaticPaths() {
  const tournaments = await getTournaments();

  const params = tournaments.map(async (tournament) => {
    const teams = await getTeamsTable(tournament);

    return teams.map((t) => ({
      params: {
        tournamentId: tournament,
        teamId: t.id,
      },
    }));
  });

  return (await Promise.all(params)).flat();
}

const { teamId, tournamentId } = Astro.params;

const team = await getTeam({ teamId, tournamentId });

if (!team) {
  return Astro.redirect(`/${tournamentId}/teams`);
}
