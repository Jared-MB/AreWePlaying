---
import Layout from "@/layouts/Layout.astro";
import { getTournaments } from "@/utils/get-tournaments";
import { getTeamsTable } from "@/utils/get-teams-table";
import MatchCard from "@/components/MatchCard.astro";

export async function getStaticPaths() {
  const tournaments = await getTournaments();
  return tournaments.flatMap((dir) => [
    {
      params: {
        tournamentId: dir,
      },
    },
  ]);
}

const { tournamentId } = Astro.params;

const teams = await getTeamsTable(tournamentId);

const sortedTeams = teams.toSorted((a, b) => a.position - b.position);
const topTeam = sortedTeams[0];
const otherTeams = sortedTeams.slice(1);
---

<Layout tournamentId={tournamentId}>
  <main class="min-h-screen bg-background">
    <div class="p-4 md:p-8">
      <div class="mx-auto max-w-7xl">
        <header
          class="mb-12 border-8 border-foreground bg-foreground p-8 text-background shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]"
        >
          <h1
            class="font-mono text-7xl font-bold uppercase leading-none tracking-tighter md:text-9xl"
          >
            TEAMS
          </h1>
          <div
            class="mt-6 flex flex-wrap gap-8 border-t-4 border-background pt-6"
          >
            <div>
              <div class="font-mono text-5xl font-bold md:text-7xl">
                {teams.length}
              </div>
              <div
                class="font-mono text-sm uppercase tracking-wider opacity-70"
              >
                Equipos totales
              </div>
            </div>
          </div>
        </header>

        <a
          href={`/${tournamentId}/teams/${topTeam.id}`}
          class="group mb-8 block"
        >
          <div
            class="border-4 border-foreground bg-primary shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
          >
            <div class="border-b-4 border-foreground bg-background px-6 py-3">
              <div
                class="font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground"
              >
                🏆 Top Performer
              </div>
            </div>
            <div class="grid gap-0 md:grid-cols-[1fr_auto]">
              <div class="p-8">
                <h2
                  class="mb-6 font-mono text-4xl font-bold uppercase leading-none tracking-tight text-primary-foreground md:text-6xl"
                >
                  <span>{topTeam.shortName}</span>
                </h2>
                <div class="flex flex-col md:flex-row gap-2 md:gap-12">
                  <div>
                    <div
                      class="font-mono text-5xl font-bold text-background md:text-7xl"
                    >
                      {topTeam.percentage}%
                    </div>
                    <div
                      class="font-mono text-sm uppercase tracking-wider text-background/70"
                    >
                      Win Rate
                    </div>
                  </div>
                  <div>
                    <div
                      class="font-mono text-5xl font-bold text-background md:text-7xl"
                    >
                      {topTeam.wins}-{topTeam.losses}
                    </div>
                    <div
                      class="font-mono text-sm uppercase tracking-wider text-background/70"
                    >
                      Record
                    </div>
                  </div>
                </div>
              </div>
              <div
                class="flex items-center justify-center border-l-4 border-foreground bg-background p-8 md:w-64"
              >
                <div
                  class="flex h-40 w-40 items-center justify-center border-4 border-foreground bg-primary text-5xl font-bold text-primary-foreground shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
                >
                  {topTeam.shortName.split(" ")[0].substring(0, 3)}
                </div>
              </div>
            </div>
          </div>
        </a>

        <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {
            otherTeams.map((team) => (
              <a href={`/${tournamentId}/teams/${team.id}`}>
                <MatchCard>
                  <div class="relative h-3 border-b-4 border-foreground bg-muted">
                    <div
                      class="h-full bg-primary"
                      style={{ width: `${team.percentage}%` }}
                    />
                  </div>

                  <div class="p-6">
                    <div class="mb-4 flex items-start justify-between gap-4">
                      <span class="flex h-16 w-16 shrink-0 items-center justify-center border-2 border-foreground bg-foreground text-lg font-bold text-background">
                        {team.shortName.split(" ")[0].substring(0, 3)}
                      </span>
                      <div class="font-mono font-bold text-lg size-10 bg-primary text-primary-foreground shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] grid place-items-center">
                        {team.position}
                      </div>
                    </div>

                    <h2
                      class:list={[
                        "mb-4 font-mono text-xl font-bold uppercase leading-tight tracking-tight",
                      ]}
                    >
                      <span>{team.shortName}</span>
                    </h2>

                    <div class="flex items-end justify-between border-t-4 border-foreground pt-4">
                      <div>
                        <div class="font-mono text-3xl font-bold leading-none">
                          {team.percentage}%
                        </div>
                        <div class="mt-1 text-xs font-bold uppercase tracking-wider text-muted-foreground">
                          Win Rate
                        </div>
                      </div>
                      <div class="text-right">
                        <div class="font-mono text-2xl font-bold leading-none">
                          {team.wins}-{team.losses}
                        </div>
                        <div class="mt-1 text-xs font-bold uppercase tracking-wider text-muted-foreground">
                          W-L
                        </div>
                      </div>
                    </div>
                  </div>
                </MatchCard>
              </a>
            ))
          }
        </section>
      </div>
    </div>
  </main>
</Layout>
