---
import type { Match } from "@/types/match";
import { getTeamLogo } from "@/utils/get-team-logo";
import {
  formatLeagueSchedule,
  leagueDateToEpoch,
  toISODateTime,
} from "@/utils/league-date";
import { getMatchSlug } from "@/utils/match-slug";
import { safeHttpUrl } from "@/utils/safe-url";
import { getTeamSlug } from "@/utils/team-slug";

interface Props {
  match: Match;
  /** El equipo dueño del calendario: el rival es el otro. */
  teamId: string;
  tournamentId: string;
  tournamentSlug: string;
  /** Sólo los partidos pasados muestran marcador. */
  showResult?: boolean;
}

const {
  match,
  teamId,
  tournamentId,
  tournamentSlug,
  showResult = false,
} = Astro.props;

const isHome = match.localTeamId === teamId;
const opponent = isHome
  ? {
      id: match.visitingTeamId,
      name: match.visitingTeam,
      position: match.visitingTeamPosition,
      record: match.visitingTeamWR,
    }
  : {
      id: match.localTeamId,
      name: match.localTeam,
      position: match.localTeamPosition,
      record: match.localTeamWR,
    };

const logo = getTeamLogo({ tournamentId, teamId: opponent.id });
const { day, time } = formatLeagueSchedule(leagueDateToEpoch(match.date));
const venueUrl = safeHttpUrl(match.locationUrl);
const venue = match.location && match.location !== "-" ? match.location : null;

// La posición viene como "(5)"; sin número no se pinta.
const position = opponent.position.replace(/\D/g, "");
const opponentMeta = [
  isHome ? "vs" : "en",
  position ? `#${position}` : null,
  opponent.record && opponent.record !== "-" ? opponent.record : null,
]
  .filter(Boolean)
  .join(" · ");

// Un partido ya pasado puede seguir sin marcador ("-") si no se capturó.
const ownPoints = Number.parseInt(
  isHome ? match.localTeamPoints : match.visitingTeamPoints,
  10,
);
const rivalPoints = Number.parseInt(
  isHome ? match.visitingTeamPoints : match.localTeamPoints,
  10,
);
const hasScore =
  showResult && Number.isFinite(ownPoints) && Number.isFinite(rivalPoints);
const isWin = ownPoints > rivalPoints;
---

<article
  class="group relative grid grid-cols-[2.5rem_1fr] overflow-hidden rounded-md bg-surface shadow-xs transition-colors duration-150 hover:bg-surface-hover/70 md:grid-cols-[3rem_1fr]"
>
  <a
    href={`/${tournamentSlug}/match/${getMatchSlug(match)}`}
    class="absolute inset-0 rounded-md focus-visible:outline-offset-2"
    aria-label={`Ver detalle del partido ${match.localTeam} contra ${match.visitingTeam}`}
  ></a>

  <div
    class:list={[
      "flex items-center justify-center",
      isHome ? "bg-primary/15 text-primary" : "bg-muted text-muted-foreground",
    ]}
  >
    <span
      class="rotate-180 font-mono text-sm font-bold uppercase tracking-widest [writing-mode:vertical-rl]"
    >
      {isHome ? "Local" : "Visita"}
    </span>
  </div>

  <div
    class="grid min-w-0 items-center gap-4 p-4 sm:grid-cols-[9rem_minmax(0,1fr)_auto] md:gap-8 md:px-6 md:py-6 lg:grid-cols-[12rem_minmax(0,1fr)_auto]"
  >
    <div class="min-w-0">
      <time
        datetime={toISODateTime(match.date)}
        class="block font-mono text-sm font-bold uppercase tabular-nums"
      >
        <span class="block">{day}</span>
        <span class="block">{time}&nbsp;hrs</span>
      </time>
      {
        venueUrl && venue ? (
          <a
            href={venueUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 mt-1 block w-fit max-w-full touch-hitbox truncate text-xs uppercase tracking-wider text-muted-foreground hover:text-foreground hover:underline"
          >
            {venue}
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        ) : (
          <p class="mt-1 truncate text-xs uppercase tracking-wider text-muted-foreground">
            {venue ?? "Sede por definir"}
          </p>
        )
      }
    </div>

    <div class="flex min-w-0 items-center gap-4">
      {
        logo ? (
          <img
            src={logo}
            alt=""
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
            class="size-12 shrink-0 object-contain md:size-14"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex size-12 shrink-0 items-center justify-center rounded-full border border-line/70 bg-primary font-bold text-primary-foreground md:size-14"
          >
            {opponent.name.substring(0, 3)}
          </span>
        )
      }
      <div class="min-w-0">
        <p class="text-sm tracking-wide text-muted-foreground tabular-nums">
          {opponentMeta}
        </p>
        <a
          href={`/${tournamentSlug}/teams/${getTeamSlug({ shortName: opponent.name })}`}
          class="relative z-10 block truncate font-mono text-lg font-bold uppercase tracking-wide hover:underline"
        >
          {opponent.name}
        </a>
      </div>
    </div>

    <div class="flex items-center gap-6 sm:justify-end">
      {
        showResult &&
          (hasScore ? (
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  "flex size-9 shrink-0 items-center justify-center rounded-full font-mono font-bold",
                  isWin
                    ? "bg-primary text-primary-foreground"
                    : "bg-destructive text-destructive-foreground",
                ]}
              >
                <span aria-hidden="true">{isWin ? "W" : "L"}</span>
                <span class="sr-only">{isWin ? "Victoria" : "Derrota"}</span>
              </span>
              <span class="font-mono text-2xl font-bold tabular-nums">
                {ownPoints} - {rivalPoints}
              </span>
            </div>
          ) : (
            <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
              Sin marcador
            </span>
          ))
      }
      <span
        aria-hidden="true"
        class="hidden min-w-40 items-center justify-center gap-2 rounded-md border border-foreground/80 px-6 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-colors duration-150 group-hover:bg-foreground group-hover:text-background md:inline-flex"
      >
        Ver detalles <span>→</span>
      </span>
    </div>
  </div>
</article>
