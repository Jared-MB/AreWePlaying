---
import DivisionLabel from "@/components/DivisionLabel.astro";
import WeekMatches from "@/components/WeekMatches.astro";

import type { Match } from "@/types/match";
import type { Tournament } from "@/types/tournament";
import type { Week } from "@/types/week";
import { getTournamentSlug } from "@/utils/tournament-slug";
import { SECTION_LINK_CLASS } from "@/constants/typography";

interface Props {
  tournament: Tournament;
  week?: Week;
  matches: Match[];
  /** Id del encabezado, para que sea único cuando hay varias listas en la página. */
  idPrefix?: string;
  /** Línea extra bajo el título, p. ej. el día de la próxima jornada. */
  subtitle?: string;
  /** Confeti y "Yes!!" al encontrar un favorito: sólo tiene sentido para hoy. */
  celebrate?: boolean;
  /** Baja a h3 cuando la lista va bajo un encabezado propio. */
  headingLevel?: 2 | 3;
}

const {
  tournament,
  week,
  matches,
  idPrefix = "matchday",
  subtitle,
  celebrate = true,
  headingLevel = 2,
} = Astro.props;

const tournamentSlug = getTournamentSlug(tournament);
const headingId = `${idPrefix}-${tournamentSlug}`;
const Heading = `h${headingLevel}` as const;
// Bajo un título de sección (nivel 3) el encabezado del torneo es menor y no
// enlaza: el enlace visible es "Ver más", para no repetir el mismo destino.
const isNested = headingLevel === 3;
const Title = isNested ? "span" : "a";
const titleProps = isNested ? {} : { href: `/${tournamentSlug}/` };
---

<section aria-labelledby={headingId} class="relative">
  <header
    class="sticky top-(--page-header-h,0px) z-15 mb-6 -mx-3 flex items-center justify-between gap-4 bg-background px-4 py-4"
  >
    <Heading
      id={headingId}
      class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1 scroll-mt-[calc(var(--page-header-h,0px)+1rem)]"
    >
      <Title {...titleProps} class:list={[!isNested && "hover:underline"]}>
        <DivisionLabel tournament={tournament} size="md" />
      </Title>
      {
        subtitle ? (
          <span class="font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground">
            {subtitle}
          </span>
        ) : null
      }
    </Heading>
    <a
      href={`/${tournamentSlug}/`}
      class={SECTION_LINK_CLASS}
    >
      Ver más
      {
        /* Hay un "Ver más" por torneo: el destino tiene que distinguirse fuera de contexto. */
      }
      <span class="sr-only">
        de División {tournament.division}
        {tournament.category}
      </span>
    </a>
  </header>
  <WeekMatches
    matches={matches}
    week={week}
    tournamentSlug={tournamentSlug}
    tournamentId={tournament.id.toLowerCase()}
    celebrate={celebrate}
  />
</section>
