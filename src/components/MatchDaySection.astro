---
import WeekMatches from "@/components/WeekMatches.astro";

import type { Match } from "@/types/match";
import type { Week } from "@/types/week";

interface Props {
  tournament: {
    id: string;
    division: string;
    category: string;
    conference?: string;
  };
  week?: Week;
  matches: Match[];
  /** Id del encabezado, para que sea único cuando hay varias listas en la página. */
  idPrefix?: string;
  /** Línea extra bajo el título, p. ej. el día de la próxima jornada. */
  subtitle?: string;
  /** Confeti y "Yes!!" al encontrar un favorito: sólo tiene sentido para hoy. */
  celebrate?: boolean;
  /** Baja a h3 cuando la lista va bajo un encabezado propio. */
  headingLevel?: 2 | 3;
}

const {
  tournament,
  week,
  matches,
  idPrefix = "matchday",
  subtitle,
  celebrate = true,
  headingLevel = 2,
} = Astro.props;

const tournamentId = tournament.id.toLowerCase();
const headingId = `${idPrefix}-${tournamentId}`;
const Heading = `h${headingLevel}` as const;
---

<section aria-labelledby={headingId} class="relative">
  <header
    class="sticky top-(--page-header-h,0px) z-15 mb-6 -mx-1 flex items-baseline justify-between gap-4 bg-background px-2 py-4"
  >
    <Heading
      id={headingId}
      class="flex min-w-0 flex-wrap items-baseline gap-x-4 gap-y-1 scroll-mt-8"
    >
      <a
        href={`/${tournamentId}/`}
        class="font-mono text-3xl font-bold uppercase tracking-tight md:text-4xl hover:underline"
      >
        División {tournament.division}
      </a>
      <span
        class="font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground"
      >
        {tournament.category}
        {tournament.conference ? ` · ${tournament.conference}` : null}
        {subtitle ? ` · ${subtitle}` : null}
      </span>
    </Heading>
    <a
      href={`/${tournamentId}/`}
      class="shrink-0 whitespace-nowrap hover:underline"
    >
      Ver más
      {
        /* Hay un "Ver más" por torneo: el destino tiene que distinguirse fuera de contexto. */
      }
      <span class="sr-only">
        de División {tournament.division}
        {tournament.category}
      </span>
    </a>
  </header>
  <WeekMatches
    matches={matches}
    week={week}
    tournamentId={tournamentId}
    celebrate={celebrate}
  />
</section>
