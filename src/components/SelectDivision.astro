---
import { getTournaments } from "@/utils/get-tournaments";
import { getTournamentSlug } from "@/utils/tournament-slug";

interface Props {
  id?: string;
  /** Slug del torneo activo, p. ej. "division-ii-femenil-centro". */
  defaultSelected?: string;
}

const { id, defaultSelected } = Astro.props;

const tournaments = getTournaments();

const selectId = id ?? `division-${crypto.randomUUID()}`;
---

<select
  id={selectId}
  name="division"
  data-division-select
  aria-label="Seleccionar división"
  class="h-11 w-fit max-w-full cursor-pointer rounded-md border border-input bg-surface px-4 text-sm font-bold uppercase tracking-wider text-foreground shadow-xs outline-none transition-colors hover:bg-surface-hover focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50"
>
  {
    tournaments.map((t) => (
      <option
        selected={defaultSelected === getTournamentSlug(t)}
        value={getTournamentSlug(t)}
      >
        Division {t.division}
        {t.conference ? ` - ${t.conference}` : ""} - {t.category}
      </option>
    ))
  }
</select>

<script>
  // Delegated on `document` so it keeps working after a view transition swaps
  // the <body> and replaces the select with a fresh element.
  document.addEventListener("change", (e) => {
    const $division = (
      e.target as HTMLElement | null
    )?.closest<HTMLSelectElement>("select[data-division-select]");

    if (!$division) return;

    const newTournamentSlug = $division.value;

    const path = window.location.pathname.split("/");
    path[1] = newTournamentSlug;

    const isTeam = path[2] && path[2] === "teams";

    if (isTeam) {
      const newPath = path.slice(0, 3).join("/");
      window.location.href = newPath;
      return;
    }

    window.location.href = `/${newTournamentSlug}`;
  });
</script>
