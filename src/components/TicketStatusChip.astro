---
import type { TicketStatus } from "@/utils/build-ticket";

interface Props {
  status: TicketStatus;
  class?: string;
}

const { status, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-block rounded-md border border-line/70 px-2.5 py-1 text-xs font-bold uppercase tracking-wider group-data-[active=true]:border-highlight-foreground/20",
    status === "NO INICIADO"
      ? "bg-muted text-muted-foreground group-data-[active=true]:bg-highlight-chip group-data-[active=true]:text-highlight-chip-foreground"
      : "bg-primary text-primary-foreground group-data-[active=true]:bg-highlight-chip-strong group-data-[active=true]:text-highlight-chip-strong-foreground",
    className,
  ]}
>
  {status}
</span>
