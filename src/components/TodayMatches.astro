---
import WeekMatches from "@/components/WeekMatches.astro";
import { getTodayMatches } from "@/utils/get-today-matches";
import { getTournaments } from "@/utils/get-tournaments";

// Se renderiza on-demand como server island; el CDN lo cachea unos minutos.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=60",
);

const todayMatches = await getTodayMatches();
const tournaments = getTournaments();
---

{
  todayMatches.length > 0 ? (
    <div class="space-y-12">
      {todayMatches.map(({ tournament, week, matches }) => {
        const tournamentId = tournament.id.toLowerCase();

        return (
          <section aria-labelledby={`today-${tournamentId}`} class="relative">
            <header class="sticky top-(--page-header-h,0px) z-5 mb-6 flex items-baseline justify-between gap-4 -mx-1 bg-background px-2 py-4">
              <h2
                id={`today-${tournamentId}`}
                class="min-w-0 flex flex-wrap items-baseline gap-x-4 gap-y-1 scroll-mt-8"
              >
                <a
                  href={`/${tournamentId}/`}
                  class="font-mono text-3xl font-bold uppercase tracking-tight md:text-4xl hover:underline"
                >
                  División {tournament.division}
                </a>
                <span class="font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground">
                  {tournament.category}
                  {tournament.conference ? ` · ${tournament.conference}` : null}
                </span>
              </h2>
              <a
                href={`/${tournamentId}/`}
                class="shrink-0 whitespace-nowrap hover:underline"
              >
                Ver más
              </a>
            </header>
            <WeekMatches
              matches={matches}
              week={week}
              tournamentId={tournamentId}
            />
          </section>
        );
      })}
    </div>
  ) : (
    <div class="border-2 border-foreground bg-muted p-8 text-center">
      <p class="mb-6 font-bold uppercase tracking-wider text-muted-foreground">
        Hoy no hay partidos
      </p>
      <ul class="flex flex-wrap justify-center gap-3">
        {tournaments.map((t) => (
          <li>
            <a
              href={`/${t.id.toLowerCase()}/`}
              class="inline-block border-2 border-foreground bg-background px-3 py-1 text-xs font-bold uppercase tracking-wider"
            >
              Div. {t.division} {t.category}
              {t.conference ? ` · ${t.conference}` : null}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
