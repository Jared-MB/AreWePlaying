---
import FavoriteCountdown from "@/components/favorite-countdown.tsx";
import MatchDaySection from "@/components/MatchDaySection.astro";

import { getNextMatchByTeam, getNextMatches } from "@/utils/get-next-matches";
import { getTodayMatches } from "@/utils/get-today-matches";
import { formatLeagueDay } from "@/utils/league-date";
import ArrowRight from "@lucide/astro/icons/arrow-right";

import {
  CURRENT_SEASON,
  IS_PAST_SEASON,
  LATEST_SEASON,
} from "@/constants/season";
import { CURRENT_SEASON_URL } from "@/constants/site";

// Se renderiza on-demand como server island; el CDN lo cachea unos minutos.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=60",
);

const todayMatches = await getTodayMatches();

// La cuenta regresiva de los favoritos encabeza la columna siempre; la próxima
// jornada sólo hace falta cuando no hay nada hoy y quedaría todo vacío.
const nextMatchByTeam = await getNextMatchByTeam();
const nextMatches = todayMatches.length > 0 ? [] : await getNextMatches();

const sectionTitle =
  "font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground";
---

{
  /* El margen va en cada bloque y no en un space-y del contenedor: la isla de
    favoritos se envuelve en un <astro-island> inline que no recibiría el
    margen, y además desaparece cuando no hay favoritos. */
}
<div class="mt-4">
  <FavoriteCountdown matchesByTeam={nextMatchByTeam} client:load />

  {
    todayMatches.length > 0 ? (
      <section aria-labelledby="today-matches">
        {/* El título de la columna sólo hace falta para quien no ve el diseño:
          cada torneo ya se anuncia con su propio encabezado. */}
        <h2 id="today-matches" class="sr-only">
          Partidos de hoy
        </h2>
        <div class="space-y-12">
          {todayMatches.map(({ tournament, week, matches }) => (
            <MatchDaySection
              tournament={tournament}
              week={week}
              matches={matches}
              idPrefix="today"
              headingLevel={3}
            />
          ))}
        </div>
      </section>
    ) : nextMatches.length > 0 ? (
      <section aria-labelledby="next-matches">
        <h2 id="next-matches" class={sectionTitle}>
          Próximos partidos
        </h2>
        <div class="space-y-12">
          {nextMatches.map(({ tournament, week, day, matches }) => (
            <MatchDaySection
              tournament={tournament}
              week={week}
              matches={matches}
              idPrefix="next"
              subtitle={formatLeagueDay(day)}
              celebrate={false}
              headingLevel={3}
            />
          ))}
        </div>
      </section>
    ) : IS_PAST_SEASON ? (
      /* Este despliegue es el archivo de una temporada vieja: en lugar de un
        vacío sin salida, se anuncia con el marco brutalista de la página de
        equipos y se manda a la gente al dominio de la temporada vigente. */
      <section
        aria-labelledby="past-season"
        class="border-4 border-frame bg-background shadow-[8px_8px_0px_0px_var(--color-hard-shadow)]"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b-4 border-frame bg-inverse px-6 py-3 font-mono text-sm font-bold uppercase tracking-wider text-inverse-foreground">
          <p>Temporada archivada</p>
          <p class="opacity-70">No hay más partidos por mostrar</p>
        </div>
        <div class="p-6 md:p-8">
          <h2
            id="past-season"
            class="font-mono text-4xl font-bold uppercase leading-none tracking-tighter tabular-nums sm:text-5xl md:text-7xl"
          >
            {CURRENT_SEASON}
          </h2>
          <p class="mt-6 border-t-4 border-frame pt-6 text-pretty">
            Esta temporada ya terminó: aquí sólo quedan guardadas sus jornadas y
            sus resultados.
          </p>
          <div class="mt-8 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
            <a
              href={CURRENT_SEASON_URL}
              class="group inline-flex items-center gap-3 border-4 border-frame bg-primary px-6 py-4 font-mono text-sm font-bold uppercase tracking-wider text-primary-foreground shadow-[6px_6px_0px_0px_var(--color-hard-shadow)] outline-none transition-[translate,box-shadow] duration-180 hover:translate-x-1 hover:translate-y-1 hover:shadow-[2px_2px_0px_0px_var(--color-hard-shadow)] focus-visible:ring-[3px] focus-visible:ring-ring/50 motion-reduce:transition-none touch-manipulation"
            >
              Ir a la temporada {LATEST_SEASON}
              <ArrowRight
                class="size-5 shrink-0 transition-transform duration-180 group-hover:translate-x-1 motion-reduce:transition-none"
                aria-hidden="true"
              />
            </a>
            <a
              href="#divisiones"
              class="font-mono text-sm font-bold uppercase tracking-wider underline decoration-2 underline-offset-4 hover:text-primary"
            >
              Ver las jornadas de {CURRENT_SEASON}
            </a>
          </div>
        </div>
      </section>
    ) : (
      <section
        aria-labelledby="no-matches"
        class="rounded-md bg-surface p-6 shadow-xs"
      >
        <h2 id="no-matches" class={sectionTitle}>
          Sin partidos programados
        </h2>
        <p class="mt-2 text-sm">
          Todavía no hay partidos para hoy ni una próxima jornada publicada.{" "}
          <a href="#divisiones" class="underline underline-offset-4">
            Revisa las divisiones
          </a>{" "}
          para ver jornadas anteriores.
        </p>
      </section>
    )
  }
</div>
