---
import FavoriteCountdown from "@/components/favorite-countdown.tsx";
import MatchDaySection from "@/components/MatchDaySection.astro";

import { getNextMatchByTeam, getNextMatches } from "@/utils/get-next-matches";
import { getTodayMatches } from "@/utils/get-today-matches";
import { formatLeagueDay } from "@/utils/league-date";

// Se renderiza on-demand como server island; el CDN lo cachea unos minutos.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=600, stale-while-revalidate=60",
);

const todayMatches = await getTodayMatches();

// La cuenta regresiva de los favoritos encabeza la columna siempre; la próxima
// jornada sólo hace falta cuando no hay nada hoy y quedaría todo vacío.
const nextMatchByTeam = await getNextMatchByTeam();
const nextMatches = todayMatches.length > 0 ? [] : await getNextMatches();

const sectionTitle =
  "font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground";
---

{
  /* El margen va en cada bloque y no en un space-y del contenedor: la isla de
    favoritos se envuelve en un <astro-island> inline que no recibiría el
    margen, y además desaparece cuando no hay favoritos. */
}
<div class="mt-4">
  <FavoriteCountdown matchesByTeam={nextMatchByTeam} client:load />

  {
    todayMatches.length > 0 ? (
      <section aria-labelledby="today-matches">
        {/* El título de la columna sólo hace falta para quien no ve el diseño:
          cada torneo ya se anuncia con su propio encabezado. */}
        <h2 id="today-matches" class="sr-only">
          Partidos de hoy
        </h2>
        <div class="space-y-12">
          {todayMatches.map(({ tournament, week, matches }) => (
            <MatchDaySection
              tournament={tournament}
              week={week}
              matches={matches}
              idPrefix="today"
              headingLevel={3}
            />
          ))}
        </div>
      </section>
    ) : nextMatches.length > 0 ? (
      <section aria-labelledby="next-matches">
        <h2 id="next-matches" class={sectionTitle}>
          Próximos partidos
        </h2>
        <div class="space-y-12">
          {nextMatches.map(({ tournament, week, day, matches }) => (
            <MatchDaySection
              tournament={tournament}
              week={week}
              matches={matches}
              idPrefix="next"
              subtitle={formatLeagueDay(day)}
              celebrate={false}
              headingLevel={3}
            />
          ))}
        </div>
      </section>
    ) : (
      <section
        aria-labelledby="no-matches"
        class="rounded-md bg-surface p-6 shadow-xs"
      >
        <h2 id="no-matches" class={sectionTitle}>
          Sin partidos programados
        </h2>
        <p class="mt-2 text-sm">
          Todavía no hay partidos para hoy ni una próxima jornada publicada.{" "}
          <a href="#divisiones" class="underline underline-offset-4">
            Revisa las divisiones
          </a>{" "}
          para ver jornadas anteriores.
        </p>
      </section>
    )
  }
</div>
