---
import { getLogoBackground } from "@/utils/get-logo-background";

interface Props {
  logo: string | null;
  initials: string;
  /** Tamaño y extras; el escudo siempre va sobre un círculo blanco. */
  class?: string;
  /** Resolución intrínseca, para reservar el espacio y evitar saltos. */
  size?: number;
}

const { logo, initials, class: className, size = 96 } = Astro.props;
// Un escudo cuadrado con fondo de color pinta el círculo de ese color.
const background = getLogoBackground(logo);

// El margen blanco sale de encoger el <img> dentro del círculo, no de un
// padding en %: ese se calcula sobre el ancho del contenedor, no del escudo.
// 68% porque un cuadrado sólo cabe en el círculo hasta ~70% (1/√2): más, y las
// esquinas de un escudo ancho (un logotipo con texto) se salen del borde.
---

{
  logo ? (
    <span
      class:list={[
        "crest-fade flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-(--crest-bg,white)",
        // Sobre un banner del mismo color (sale del mismo escudo) el círculo se
        // perdería: el anillo conserva la forma.
        background && "ring-2 ring-white/80",
        className,
      ]}
      style={background ? { "--crest-bg": background } : undefined}
    >
      <img
        src={logo}
        alt=""
        width={size}
        height={size}
        class="size-[68%] object-contain"
      />
    </span>
  ) : (
    <span
      aria-hidden="true"
      class:list={[
        "flex shrink-0 items-center justify-center rounded-full bg-primary font-mono font-bold text-highlight-foreground",
        // En un boleto favorito el fondo es el color primario: las iniciales
        // cambian al chip oscuro para no perderse. El escudo no lo hace, su
        // círculo blanco y su degradado de borde van juntos.
        "group-data-[active=true]:bg-highlight-chip-strong group-data-[active=true]:text-highlight-chip-strong-foreground",
        className,
      ]}
    >
      {initials}
    </span>
  )
}
