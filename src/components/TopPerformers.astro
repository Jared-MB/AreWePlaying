---
import DivisionLabel from "@/components/DivisionLabel.astro";
import TeamCrest from "@/components/TeamCrest.astro";
import { teamInitials } from "@/utils/get-match-card";
import { getTopTeams } from "@/utils/get-top-teams";
import { getTournamentSlug } from "@/utils/tournament-slug";
import { getTeamSlug } from "@/utils/team-slug";
import { SECTION_LINK_CLASS } from "@/constants/typography";

const topTeams = await getTopTeams();

// El líder va al centro del podio: 2.º a la izquierda, 1.º en medio, 3.º a la derecha.
const SLOT_COLUMN = ["col-start-2", "col-start-1", "col-start-3"];
const STEP_STYLE = [
  "h-17 bg-primary text-highlight-foreground text-4xl group-hover:brightness-110",
  "h-11 bg-foreground/10 text-3xl group-hover:bg-foreground/20",
  "h-8 bg-foreground/10 text-xl group-hover:bg-foreground/20",
];
const CREST_SIZE = ["size-14", "size-11", "size-11"];
---

<div class="space-y-8">
  {
    topTeams.map(({ tournament, teams: ranked }) => {
      const tournamentSlug = getTournamentSlug(tournament);
      // Sin partidos jugados la tabla llega con posición 0 para todos.
      const teams = ranked.filter((team) => team.position > 0);

      return (
        <section
          aria-labelledby={`top-${tournamentSlug}`}
          class="overflow-hidden rounded-lg bg-surface px-4 pt-3.5 text-foreground shadow-xs ring-1 ring-line/45"
        >
          <header class="flex items-center justify-between gap-2">
            <h3 id={`top-${tournamentSlug}`} class="min-w-0">
              <DivisionLabel tournament={tournament} size="sm" />
            </h3>
            <a
              href={`/${tournamentSlug}/teams/`}
              class={SECTION_LINK_CLASS}
            >
              Tabla →
            </a>
          </header>

          {teams.length > 0 ? (
            <ol class="grid grid-cols-3 items-end gap-x-2 pt-5">
              {teams.map((team, index) => (
                <li class={`row-start-1 ${SLOT_COLUMN[index]}`}>
                  <a
                    href={`/${tournamentSlug}/teams/${getTeamSlug(team)}`}
                    class="group flex flex-col items-center text-center focus-visible:outline-offset-[-2px]"
                  >
                    <span class="flex flex-col items-center gap-1.5 px-0.5 pb-2.5">
                      <TeamCrest
                        logo={team.logo}
                        initials={teamInitials(team.shortName)}
                        class={`${CREST_SIZE[index]} text-xs`}
                        size={56}
                      />
                      <span class="line-clamp-2 min-h-[2.5em] text-xs font-bold uppercase leading-tight tracking-wide wrap-anywhere">
                        {team.shortName}
                      </span>
                      <span
                        class="whitespace-nowrap font-pixel text-[22px] font-bold leading-none tabular-nums"
                        translate="no"
                      >
                        {team.wins}-{team.losses}
                      </span>
                    </span>
                    <span
                      class={`grid w-full place-items-center rounded-t-sm font-pixel font-bold tabular-nums transition-[filter,background-color] ${STEP_STYLE[index]}`}
                      translate="no"
                    >
                      <span class="sr-only">Posición </span>
                      {team.position}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="py-3 text-sm font-bold uppercase tracking-wider text-muted-foreground">
              Sin tabla disponible
            </p>
          )}
        </section>
      );
    })
  }
</div>
