---
// Envuelve una lista de partidos: si alguno es de un equipo favorito, hace
// scroll hasta él al cargar la página.
---

<div data-scroll-to-favorite class="contents">
  <slot />
</div>

<script>
  // Las tarjetas se hidratan por separado, así que se agrupan en un frame y se
  // elige la que aparece primero en el documento.
  let pendingCards: HTMLElement[] = [];
  let hasScrolled = false;

  // La cuenta regresiva de favoritos se monta encima de la lista y la empuja
  // hacia abajo: hay que esperarla o el scroll deja el partido descentrado.
  const SETTLE_TIMEOUT = 300;
  let isCountdownSettled = false;
  let onCountdownSettled: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    pendingCards = [];
    hasScrolled = false;
    isCountdownSettled = false;
    onCountdownSettled = undefined;
  });

  window.addEventListener("favorite-countdown-settled", () => {
    isCountdownSettled = true;
    onCountdownSettled?.();
    onCountdownSettled = undefined;
  });

  /** Ejecuta `run` cuando la cuenta regresiva ya ocupó su lugar (o al vencer el plazo). */
  function whenSettled(run: () => void) {
    if (isCountdownSettled) {
      requestAnimationFrame(run);
      return;
    }

    const timeout = window.setTimeout(once, SETTLE_TIMEOUT);

    function once() {
      window.clearTimeout(timeout);
      onCountdownSettled = undefined;
      requestAnimationFrame(run);
    }

    onCountdownSettled = once;
  }

  window.addEventListener("favorite-match", (event) => {
    const $card = (event as CustomEvent<HTMLElement | null>).detail;
    if (hasScrolled || !$card?.closest("[data-scroll-to-favorite]")) return;

    pendingCards.push($card);
    if (pendingCards.length > 1) return;

    whenSettled(() => {
      const [$first] = pendingCards.toSorted((a, b) =>
        a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
      );
      pendingCards = [];
      hasScrolled = true;

      // No pisar el scroll del usuario ni la posición restaurada al volver atrás.
      if (!$first || window.scrollY > 0) return;

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      // Centrado para que no quede debajo de los encabezados sticky.
      $first.scrollIntoView({
        block: "center",
        behavior: reduceMotion ? "auto" : "smooth",
      });
    });
  });
</script>
