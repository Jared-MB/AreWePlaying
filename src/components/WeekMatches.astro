---
import MatchCard from "@/components/match-card.tsx";

import { toISODateTime } from "@/utils/league-date";

import type { Match } from "@/types/match";
import type { Week } from "@/types/week";
import { getMatchSlug } from "@/utils/match-slug";
import { getTeamSlug } from "@/utils/team-slug";
import { safeHttpUrl } from "@/utils/safe-url";

interface Props {
  matches: Match[];
  week?: Week;
  tournamentSlug: string;
  /** Confeti y "Yes!!" al encontrar un favorito; se apaga para partidos futuros. */
  celebrate?: boolean;
}

const { matches, week, tournamentSlug, celebrate = true } = Astro.props;

// En móvil cada campo lleva su etiqueta visible; en escritorio la columna ya se
// entiende sola, pero la etiqueta sigue en el árbol de accesibilidad (sr-only en
// vez de hidden) para que un lector de pantalla no lea valores sueltos.
const fieldLabel =
  "mb-1 text-xs font-bold uppercase tracking-wider text-muted-foreground md:sr-only group-data-[active=true]:text-highlight-foreground/70";
const score =
  "shrink-0 rounded-md border border-line/70 px-4 py-1 text-2xl font-bold tabular-nums group-data-[active=true]:border-highlight-foreground/20";
---

{
  matches.length === 0 ? (
    <p class="rounded-md bg-surface p-6 text-center font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground shadow-xs">
      No hay partidos programados para esta semana
    </p>
  ) : (
    // biome-ignore lint/a11y/noRedundantRoles: sin bullets Safari deja de anunciar la lista
    <ul role="list" class="list-none">
      {matches.map((game) => {
        const [day, time] = game.date.split(" ");
        const matchup = `${game.localTeam} vs ${game.visitingTeam}`;
        const venueUrl = safeHttpUrl(game.locationUrl);
        const hasScore = game.started === 0 || game.live === 0;
        const status =
          game.live === 1
            ? "EN CURSO"
            : game.started === 1
              ? "NO INICIADO"
              : "COMPLETADO";

        return (
          <li class="border-t border-t-line/70 first:border-t-0">
            <MatchCard
              visitingTeamId={game.visitingTeamId}
              localTeamId={game.localTeamId}
              celebrate={celebrate}
              client:load
            >
              <article aria-label={matchup}>
                <a
                  class="absolute inset-0 cursor-pointer outline-offset-4 focus-visible:outline-2"
                  href={`/${tournamentSlug}/match/${getMatchSlug(game)}`}
                  aria-label={`Ver detalle del partido entre ${game.localTeam} contra ${game.visitingTeam}`}
                />
                <dl class="grid gap-4 p-6 md:grid-cols-12 md:items-center group-data-[active=true]:text-highlight-foreground">
                  <div class="col-span-12 md:col-span-2">
                    <dt class={fieldLabel}>Fecha</dt>
                    <dd>
                      <time class="block" datetime={toISODateTime(game.date)}>
                        <span class="block font-bold tabular-nums">
                          {time} HRS
                        </span>
                        <span class="block text-sm tabular-nums text-muted-foreground group-data-[active=true]:text-highlight-foreground/75">
                          {day}
                        </span>
                      </time>
                      {week?.week ? (
                        <span class="mt-2 inline-block rounded-md border border-line bg-muted px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-muted-foreground group-data-[active=true]:border-highlight-foreground/20 group-data-[active=true]:bg-highlight-chip group-data-[active=true]:text-highlight-chip-foreground">
                          {week.week}
                        </span>
                      ) : null}
                    </dd>
                  </div>

                  <div class="col-span-12 md:col-span-5">
                    <dt class={fieldLabel}>Equipos</dt>
                    <dd class="space-y-2">
                      <div class="flex items-center gap-3">
                        <span
                          aria-hidden="true"
                          class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line/70 bg-primary text-xs font-bold text-primary-foreground group-data-[active=true]:border-highlight-foreground/20 group-data-[active=true]:bg-highlight-chip-strong group-data-[active=true]:text-highlight-chip-strong-foreground"
                        >
                          {game.localTeam.split(" ")[0].substring(0, 3)}
                        </span>
                        <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                          <a
                            href={`/${tournamentSlug}/teams/${getTeamSlug({ shortName: game.localTeam })}`}
                            class="relative z-10 min-w-0 touch-hitbox wrap-break-word font-bold uppercase tracking-wide hover:underline"
                          >
                            {game.localTeam}
                          </a>
                          {hasScore ? (
                            <p
                              class={`${score} ${
                                Number(game.localTeamPoints) >
                                Number(game.visitingTeamPoints || 0)
                                  ? "bg-primary text-primary-foreground group-data-[active=true]:bg-highlight-chip-strong group-data-[active=true]:text-highlight-chip-strong-foreground"
                                  : "bg-muted text-muted-foreground group-data-[active=true]:bg-highlight-chip group-data-[active=true]:text-highlight-chip-muted-foreground"
                              }`}
                            >
                              {game.localTeamPoints}
                              <span class="sr-only"> puntos</span>
                            </p>
                          ) : null}
                        </div>
                      </div>
                      <div class="flex items-center gap-3">
                        <span
                          aria-hidden="true"
                          class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line/70 bg-secondary text-xs font-bold text-secondary-foreground group-data-[active=true]:border-highlight-foreground/20 group-data-[active=true]:bg-highlight-chip group-data-[active=true]:text-highlight-foreground"
                        >
                          {game.visitingTeam.split(" ")[0].substring(0, 3)}
                        </span>
                        <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                          <a
                            href={`/${tournamentSlug}/teams/${getTeamSlug({ shortName: game.visitingTeam })}`}
                            class="relative z-10 min-w-0 touch-hitbox wrap-break-word font-bold uppercase tracking-wide hover:underline"
                          >
                            {game.visitingTeam}
                          </a>
                          {hasScore ? (
                            <p
                              class={`${score} ${
                                Number(game.visitingTeamPoints) >
                                Number(game.localTeamPoints || 0)
                                  ? "bg-primary text-primary-foreground group-data-[active=true]:bg-highlight-chip-strong group-data-[active=true]:text-highlight-chip-strong-foreground"
                                  : "bg-muted text-muted-foreground group-data-[active=true]:bg-highlight-chip group-data-[active=true]:text-highlight-chip-muted-foreground"
                              }`}
                            >
                              {game.visitingTeamPoints}
                              <span class="sr-only"> puntos</span>
                            </p>
                          ) : null}
                        </div>
                      </div>
                    </dd>
                  </div>

                  <div class="col-span-12 md:col-span-3">
                    <dt class={fieldLabel}>Lugar</dt>
                    <dd class="text-sm font-bold uppercase tracking-wide">
                      {venueUrl ? (
                        <a
                          href={venueUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="relative z-10 inline-block touch-hitbox hover:underline"
                        >
                          {game.location}
                          <span class="sr-only">
                            {" "}
                            (abre en una pestaña nueva)
                          </span>
                        </a>
                      ) : (
                        <span>
                          <span aria-hidden="true">-</span>
                          <span class="sr-only">Por definir</span>
                        </span>
                      )}
                    </dd>
                  </div>

                  <div class="col-span-12 md:col-span-2">
                    <dt class={fieldLabel}>Estatus</dt>
                    <dd>
                      <span
                        class={`inline-block rounded-md border border-line/70 px-3 py-1 text-xs font-bold uppercase tracking-wider group-data-[active=true]:border-highlight-foreground/20 ${
                          status === "NO INICIADO"
                            ? "bg-muted text-muted-foreground group-data-[active=true]:bg-highlight-chip group-data-[active=true]:text-highlight-chip-foreground"
                            : "bg-primary text-primary-foreground group-data-[active=true]:bg-highlight-chip-strong group-data-[active=true]:text-highlight-chip-strong-foreground"
                        }`}
                      >
                        {status}
                      </span>
                    </dd>
                  </div>
                </dl>
              </article>
            </MatchCard>
          </li>
        );
      })}
    </ul>
  )
}
