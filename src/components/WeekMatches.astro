---
import MatchCard from "@/components/match-card.tsx";
import MatchTicket from "@/components/MatchTicket.astro";

import type { Match } from "@/types/match";
import type { Week } from "@/types/week";
import { buildTicket } from "@/utils/build-ticket";

interface Props {
  matches: Match[];
  week?: Week;
  tournamentSlug: string;
  /** Id en minúsculas del torneo: de ahí salen los escudos. */
  tournamentId: string;
  /** Confeti y "Yes!!" al encontrar un favorito; se apaga para partidos futuros. */
  celebrate?: boolean;
}

const {
  matches,
  week,
  tournamentSlug,
  tournamentId,
  celebrate = true,
} = Astro.props;
---

{
  matches.length === 0 ? (
    <p class="rounded-md bg-surface p-6 text-center font-mono text-sm font-bold uppercase tracking-wider text-muted-foreground shadow-xs">
      No hay partidos programados para esta semana
    </p>
  ) : (
    // biome-ignore lint/a11y/noRedundantRoles: sin bullets Safari deja de anunciar la lista
    <ul role="list" class="grid list-none gap-5">
      {matches.map((game) => {
        const ticket = buildTicket({ game, week, tournamentId, tournamentSlug });

        return (
          <li>
            <MatchCard
              visitingTeamId={game.visitingTeamId}
              localTeamId={game.localTeamId}
              celebrate={celebrate}
              className="group relative"
              client:load
            >
              <MatchTicket ticket={ticket} />
            </MatchCard>
          </li>
        );
      })}
    </ul>
  )
}
