---
import TeamCrest from "@/components/TeamCrest.astro";
import type { HeroTeam, MatchHero } from "@/utils/match-hero";
import { MapPin } from "@lucide/astro";

interface Props {
  hero: MatchHero;
}

const { hero } = Astro.props;
const { local, visiting, status } = hero;
const hasScore = status !== "upcoming";

const sides: { team: HeroTeam; align: "start" | "end" }[] = [
  { team: local, align: "end" },
  { team: visiting, align: "start" },
];
---

<section
  class="relative isolate overflow-hidden rounded-md bg-neutral-950 text-white shadow-xs"
>
  {/* Los escudos gigantes y apagados a los lados, como el fondo de la NBA. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    {
      local.logo && (
        <img
          src={local.logo}
          alt=""
          class="absolute top-1/2 -left-24 size-96 -translate-y-1/2 object-contain opacity-10 grayscale invert md:-left-12"
        />
      )
    }
    {
      visiting.logo && (
        <img
          src={visiting.logo}
          alt=""
          class="absolute top-1/2 -right-24 size-96 -translate-y-1/2 object-contain opacity-10 grayscale invert md:-right-12"
        />
      )
    }
  </div>

  {/* Acciones (compartir) en su propia fila: arriba a la derecha sin tapar el texto. */}
  <div class="flex justify-end px-4 pt-4 md:px-6 md:pt-6">
    <slot name="actions" />
  </div>

  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 pt-2 pb-8 text-center md:px-8 md:pb-12"
  >
    {/* El marcador ya dice quién juega; el título queda para lectores de pantalla. */}
    <h1 class="sr-only">{hero.title}</h1>
    <p class="text-xs font-bold uppercase tracking-widest text-white/60">
      {hero.eyebrow}
    </p>

    <div
      class="grid w-full grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 md:gap-6"
    >
      {
        sides.map(({ team, align }) => (
          <div
            class:list={[
              "flex min-w-0 items-center gap-3 md:gap-5",
              align === "end"
                ? "flex-row justify-end"
                : "flex-row-reverse justify-end",
              align === "start" && "col-start-3",
            ]}
          >
            <a
              href={team.href}
              class="flex min-w-0 flex-col items-center gap-1 hover:underline"
            >
              <TeamCrest
                logo={team.logo}
                initials={team.initials}
                size={64}
                class="size-12 text-sm md:size-16"
              />
              <span
                class="max-w-full truncate font-mono text-xs font-bold uppercase tracking-wider"
                transition:name={team.name}
              >
                {team.name}
              </span>
            </a>
            {hasScore && (
              <span
                class:list={[
                  "relative font-mono text-4xl font-bold tabular-nums md:text-6xl",
                  !team.isWinner && "text-white/50",
                ]}
              >
                <span class="sr-only">{team.name}: </span>
                {team.points}
                {team.isWinner && (
                  <span
                    aria-hidden="true"
                    class:list={[
                      "absolute top-1/2 -translate-y-1/2 text-base text-white md:text-xl",
                      align === "end"
                        ? "-right-4 md:-right-6"
                        : "-left-4 rotate-180 md:-left-6",
                    ]}
                  >
                    ◂
                  </span>
                )}
              </span>
            )}
          </div>
        ))
      }

      <div
        class="col-start-2 row-start-1 flex flex-col items-center gap-1 px-2 md:px-6"
      >
        {
          status === "live" ? (
            <span class="flex items-center gap-2 rounded-full bg-red-600 px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider">
              <span class="size-2 rounded-full bg-white motion-safe:animate-pulse" />
              {hero.statusLabel}
            </span>
          ) : (
            <span class="font-mono text-sm font-bold uppercase tracking-wider md:text-base">
              {status === "finished" ? "Final" : hero.time || "VS"}
            </span>
          )
        }
      </div>
    </div>

    <div class="flex flex-col items-center gap-2">
      <p class="text-base font-bold text-white/80 first-letter:uppercase">
        {hero.date}{hero.time ? ` · ${hero.time} hrs` : ""}
      </p>
      {
        hero.venueUrl ? (
          <a
            href={hero.venueUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-white/70 hover:text-white hover:underline"
          >
            <MapPin class="size-4" aria-hidden="true" />
            {hero.venue}
            <span class="sr-only"> (abre en una pestaña nueva)</span>
          </a>
        ) : (
          <p class="flex items-center gap-2 text-sm text-white/70">
            <MapPin class="size-4" aria-hidden="true" />
            {hero.venue}
          </p>
        )
      }
    </div>
  </div>
</section>
